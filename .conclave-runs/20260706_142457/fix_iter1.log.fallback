+import { describe, it, expect } from 'vitest'
+import { createTestConvex, seedTenant } from './testHelpers'
+import { api } from './_generated/api'
+import type { Id } from './_generated/dataModel'
+
+function asAdmin(t: any, userId: string, clerkOrgId: string) {
+  return t.withIdentity({
+    subject: userId,
+    email: `${userId}@example.com`,
+    org_id: clerkOrgId,
+    org_role: 'org:admin',
+  })
+}
+
+function asRole(t: any, userId: string, clerkOrgId: string, role: string) {
+  return t.withIdentity({
+    subject: userId,
+    email: `${userId}@example.com`,
+    org_id: clerkOrgId,
+    org_role: role,
+  })
+}
+
+describe('hrCases', () => {
+  it('creates a case for a candidate and resolves the owner', async () => {
+    const t = createTestConvex()
+    const clerkOrgId = 'org_hr_cases'
+    const adminId = 'user_hr_admin'
+    await seedTenant(t, clerkOrgId, adminId)
+
+    let candidateId: Id<'candidates'>
+    await t.run(async (ctx) => {
+      const tenant = await ctx.db
+        .query('tenants')
+        .withIndex('by_clerk_org_id', (q) => q.eq('clerkOrgId', clerkOrgId))
+        .unique()
+      if (!tenant) throw new Error('Tenant not found.')
+      candidateId = await ctx.db.insert('candidates', {
+        tenantId: tenant._id,
+        clerkUserId: 'user_candidate_hr',
+        email: 'candidate@example.com',
+        displayName: 'Candidate One',
+        status: 'applied',
+        createdAt: new Date().toISOString(),
+      })
+    })
+
+    const caseId = await asAdmin(t, adminId, clerkOrgId).mutation(
+      api.hrCases.createHrCase,
+      {
+        clerkOrgId,
+        subjectType: 'candidate',
+        subjectId: candidateId as unknown as string,
+        category: 'license',
+        title: 'Missing license',
+        description: 'Please upload a valid license.',
+      },
+    )
+
+    const hrCase = await t.run(async (ctx) => ctx.db.get(caseId as Id<'hrCases'>))
+    expect(hrCase).toBeDefined()
+    expect(hrCase?.status).toBe('open')
+    expect(hrCase?.category).toBe('license')
+    expect(hrCase?.ownerMemberId).toBeDefined()
+  })
+
+  it('creates a case for an employee', async () => {
+    const t = createTestConvex()
+    const clerkOrgId = 'org_hr_employee_case'
+    const adminId = 'user_hr_employee_admin'
+    await seedTenant(t, clerkOrgId, adminId)
+
+    let employeeId: Id<'employeeProfiles'>
+    await t.run(async (ctx) => {
+      const tenant = await ctx.db
+        .query('tenants')
+        .withIndex('by_clerk_org_id', (q) => q.eq('clerkOrgId', clerkOrgId))
+        .unique()
+      if (!tenant) throw new Error('Tenant not found.')
+      employeeId = await ctx.db.insert('employeeProfiles', {
+        tenantId: tenant._id,
+        clerkUserId: 'user_employee_hr',
+        email: 'employee@example.com',
+        displayName: 'Employee One',
+        adpSyncStatus: 'none',
+        createdAt: new Date().toISOString(),
+      })
+    })
+
+    const caseId = await asAdmin(t, adminId, clerkOrgId).mutation(
+      api.hrCases.createHrCase,
+      {
+        clerkOrgId,
+        subjectType: 'employee',
+        subjectId: employeeId as unknown as string,
+        category: 'incident',
+        title: 'Incident report',
+        description: 'Details of incident.',
+      },
+    )
+
+    const hrCase = await t.run(async (ctx) => ctx.db.get(caseId as Id<'hrCases'>))
+    expect(hrCase?.subjectType).toBe('employee')
+    expect(hrCase?.status).toBe('open')
+  })
+
+  it('lists only tenant cases with resolved names', async () => {
+    const t = createTestConvex()
+    const clerkOrgId = 'org_hr_list'
+    const adminId = 'user_hr_list_admin'
+    await seedTenant(t, clerkOrgId, adminId)
+
+    let candidateId: Id<'candidates'>
+    await t.run(async (ctx) => {
+      const tenant = await ctx.db
+        .query('tenants')
+        .withIndex('by_clerk_org_id', (q) => q.eq('clerkOrgId', clerkOrgId))
+        .unique()
+      if (!tenant) throw new Error('Tenant not found.')
+      candidateId = await ctx.db.insert('candidates', {
+        tenantId: tenant._id,
+        clerkUserId: 'user_list_candidate',
+        email: 'list@example.com',
+        displayName: 'List Candidate',
+        status: 'applied',
+        createdAt: new Date().toISOString(),
+      })
+    })
+
+    await asAdmin(t, adminId, clerkOrgId).mutation(api.hrCases.createHrCase, {
+      clerkOrgId,
+      subjectType: 'candidate',
+      subjectId: candidateId as unknown as string,
+      category: 'background_check',
+      title: 'Background check',
+      description: 'Run background check.',
+    })
+
+    const listed = await asAdmin(t, adminId, clerkOrgId).query(
+      api.hrCases.listHrCases,
+      { clerkOrgId },
+    )
+
+    expect(listed).toHaveLength(1)
+    expect(listed[0].subjectName).toBe('List Candidate')
+    expect(listed[0].ownerName).toBeDefined()
+  })
+
+  it('updates case status and fields', async () => {
+    const t = createTestConvex()
+    const clerkOrgId = 'org_hr_update'
+    const adminId = 'user_hr_update_admin'
+    await seedTenant(t, clerkOrgId, adminId)
+
+    let candidateId: Id<'candidates'>
+    await t.run(async (ctx) => {
+      const tenant = await ctx.db
+        .query('tenants')
+        .withIndex('by_clerk_org_id', (q) => q.eq('clerkOrgId', clerkOrgId))
+        .unique()
+      if (!tenant) throw new Error('Tenant not found.')
+      candidateId = await ctx.db.insert('candidates', {
+        tenantId: tenant._id,
+        clerkUserId: 'user_update_candidate',
+        email: 'update@example.com',
+        displayName: 'Update Candidate',
+        status: 'applied',
+        createdAt: new Date().toISOString(),
+      })
+    })
+
+    const caseId = await asAdmin(t, adminId, clerkOrgId).mutation(
+      api.hrCases.createHrCase,
+      {
+        clerkOrgId,
+        subjectType: 'candidate',
+        subjectId: candidateId as unknown as string,
+        category: 'other',
+        title: 'Update case',
+        description: 'Update me.',
+      },
+    )
+
+    await asAdmin(t, adminId, clerkOrgId).mutation(api.hrCases.updateHrCase, {
+      clerkOrgId,
+      caseId: caseId as Id<'hrCases'>,
+      status: 'in_review',
+      title: 'Updated title',
+    })
+
+    const updated = await t.run(async (ctx) =>
+      ctx.db.get(caseId as Id<'hrCases'>),
+    )
+    expect(updated?.status).toBe('in_review')
+    expect(updated?.title).toBe('Updated title')
+  })
+
+  it('blocks cross-tenant updates', async () => {
+    const t = createTestConvex()
+    const orgA = 'org_hr_a'
+    const adminA = 'user_hr_a_admin'
+    const orgB = 'org_hr_b'
+    const adminB = 'user_hr_b_admin'
+    await seedTenant(t, orgA, adminA)
+    await seedTenant(t, orgB, adminB)
+
+    let candidateId: Id<'candidates'>
+    await t.run(async (ctx) => {
+      const tenant = await ctx.db
+        .query('tenants')
+        .withIndex('by_clerk_org_id', (q) => q.eq('clerkOrgId', orgA))
+        .unique()
+      if (!tenant) throw new Error('Tenant not found.')
+      candidateId = await ctx.db.insert('candidates', {
+        tenantId: tenant._id,
+        clerkUserId: 'user_cross_candidate',
+        email: 'cross@example.com',
+        displayName: 'Cross Candidate',
+        status: 'applied',
+        createdAt: new Date().toISOString(),
+      })
+    })
+
+    const caseId = await asAdmin(t, adminA, orgA).mutation(
+      api.hrCases.createHrCase,
+      {
+        clerkOrgId: orgA,
+        subjectType: 'candidate',
+        subjectId: candidateId as unknown as string,
+        category: 'cross',
+        title: 'Cross case',
+        description: 'Cross tenant.',
+      },
+    )
+
+    await expect(
+      asAdmin(t, adminB, orgB).mutation(api.hrCases.updateHrCase, {
+        clerkOrgId: orgB,
+        caseId: caseId as Id<'hrCases'>,
+        status: 'resolved',
+      }),
+    ).rejects.toThrow()
+  })
+
+  it('rejects non-hr roles', async () => {
+    const t = createTestConvex()
+    const clerkOrgId = 'org_hr_guard'
