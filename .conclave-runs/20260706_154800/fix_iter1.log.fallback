@@ -0,0 +1,118 @@
+import { Button } from '@/shared/ui/Button'
+import { Card, CardContent } from '@/shared/ui/Card'
+import { StatusBadge } from '@/shared/ui/StatusBadge'
+import { X } from 'lucide-react'
+import type { Id } from '../../../../convex/_generated/dataModel'
+
+type DocumentStatus = 'pending_review' | 'verified' | 'rejected' | 'expired'
+type DocumentType = 'id' | 'certification' | 'signed_form' | 'other'
+
+type DocumentArchiveItem = {
+  _id: Id<'documentArchive'>
+  fileName: string
+  documentType: DocumentType
+  linkedTo: string
+  status: DocumentStatus
+  expiresAt?: string
+  verifiedBy?: string
+  verifiedAt?: string
+  rejectionReason?: string
+  downloadUrl?: string
+}
+
+type DocumentDetailPanelProps = {
+  document: DocumentArchiveItem
+  onClose: () => void
+  onVerify: (doc: DocumentArchiveItem) => void
+  onReject: (doc: DocumentArchiveItem) => void
+}
+
+const statusVariant: Record<DocumentStatus, 'neutral' | 'success' | 'danger'> = {
+  pending_review: 'neutral',
+  verified: 'success',
+  rejected: 'danger',
+  expired: 'danger',
+}
+
+function statusLabel(status: DocumentStatus) {
+  switch (status) {
+    case 'pending_review':
+      return 'Pending'
+    case 'verified':
+      return 'Verified'
+    case 'rejected':
+      return 'Rejected'
+    case 'expired':
+      return 'Expired'
+  }
+}
+
+export function DocumentDetailPanel({
+  document,
+  onClose,
+  onVerify,
+  onReject,
+}: DocumentDetailPanelProps) {
+  const isFinal = document.status === 'verified' || document.status === 'rejected'
+
+  return (
+    <div className='fixed inset-0 z-50 flex justify-end bg-atria-ink/40'>
+      <Card className='h-full w-full max-w-md overflow-y-auto rounded-none border-l border-atria-border bg-white shadow-xl'>
+        <CardContent className='space-y-5 p-5'>
+          <div className='flex items-start justify-between gap-3'>
+            <div className='min-w-0'>
+              <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+                Document
+              </p>
+              <h2 className='text-[22px] font-bold leading-tight text-atria-ink'>
+                {document.downloadUrl ? (
+                  <a
+                    href={document.downloadUrl}
+                    target='_blank'
+                    rel='noreferrer'
+                    className='text-atria-info hover:underline'
+                  >
+                    {document.fileName}
+                  </a>
+                ) : (
+                  document.fileName
+                )}
+              </h2>
+            </div>
+            <Button
+              variant='ghost'
+              size='icon'
+              onClick={onClose}
+              aria-label='Close panel'
+            >
+              <X className='h-5 w-5' />
+            </Button>
+          </div>
+
+          <div className='grid grid-cols-2 gap-4'>
+            <div>
+              <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Type</p>
+              <p className='text-base capitalize text-atria-ink'>{document.documentType.replace('_', ' ')}</p>
+            </div>
+            <div>
+              <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Linked to</p>
+              <p className='text-base text-atria-ink'>{document.linkedTo}</p>
+            </div>
+            <div>
+              <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Status</p>
+              <StatusBadge variant={statusVariant[document.status]}>
+                {statusLabel(document.status)}
+              </StatusBadge>
+            </div>
+            <div>
+              <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Expires</p>
+              <p className='text-base text-atria-ink'>
+                {document.expiresAt
+                  ? new Date(document.expiresAt).toLocaleDateString()
+                  : '—'}
+              </p>
+            </div>
+          </div>
+
+          {document.status === 'verified' && (
+            <div className='space-y-1'>
+              <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Verified</p>
+              <p className='text-base text-atria-ink'>
+                {document.verifiedBy ? `${document.verifiedBy} · ` : ''}
+                {document.verifiedAt
+                  ? new Date(document.verifiedAt).toLocaleDateString()
+                  : ''}
+              </p>
+            </div>
+          )}
+
+          {document.rejectionReason && (
+            <div className='space-y-1'>
+              <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Rejection reason</p>
+              <p className='text-base text-atria-danger'>{document.rejectionReason}</p>
+            </div>
+          )}
+
+          {!isFinal && (
+            <div className='flex flex-wrap gap-2'>
+              <Button
+                className='bg-atria-success text-white hover:bg-atria-success/90'
+                onClick={() => onVerify(document)}
+              >
+                Verify
+              </Button>
+              <Button
+                variant='ghost'
+                className='bg-atria-danger text-white hover:bg-atria-danger/90'
+                onClick={() => onReject(document)}
+              >
+                Reject
+              </Button>
+            </div>
+          )}
+        </CardContent>
+      </Card>
+    </div>
+  )
+}
diff --git a/src/features/documents/pages/DocumentArchivePage.tsx b/src/features/documents/pages/DocumentArchivePage.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/documents/pages/DocumentArchivePage.tsx
@@ -0,0 +1,263 @@
+import { useMemo, useState } from 'react'
+import { useOrganization } from '@clerk/react'
+import { useMutation, useQuery } from 'convex/react'
+import { api } from '../../../../convex/_generated/api'
+import { Button } from '@/shared/ui/Button'
+import { Checkbox } from '@/shared/ui/Checkbox'
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/shared/ui/Dialog'
+import { FieldGroup } from '@/shared/ui/FieldGroup'
+import { Input } from '@/shared/ui/Input'
+import { Select } from '@/shared/ui/Select'
+import { StatusBadge } from '@/shared/ui/StatusBadge'
+import { Textarea } from '@/shared/ui/Textarea'
+import { Toast } from '@/shared/ui/Toast'
+import { DocumentDetailPanel } from '../components/DocumentDetailPanel'
+import type { Id } from '../../../../convex/_generated/dataModel'
+
+type DocumentStatus = 'pending_review' | 'verified' | 'rejected' | 'expired'
+type DocumentType = 'id' | 'certification' | 'signed_form' | 'other'
+
+type DocumentArchiveItem = {
+  _id: Id<'documentArchive'>
+  fileName: string
+  documentType: DocumentType
+  linkedTo: string
+  status: DocumentStatus
+  expiresAt?: string
+  verifiedBy?: string
+  verifiedAt?: string
+  rejectionReason?: string
+  downloadUrl?: string
+}
+
+const STATUS_OPTIONS = [
+  { value: 'all', label: 'All' },
+  { value: 'pending_review', label: 'Pending' },
+  { value: 'verified', label: 'Verified' },
+  { value: 'rejected', label: 'Rejected' },
+  { value: 'expired', label: 'Expired' },
+]
+
+const TYPE_OPTIONS = [
+  { value: 'all', label: 'All' },
+  { value: 'id', label: 'ID' },
+  { value: 'certification', label: 'Certification' },
+  { value: 'signed_form', label: 'Signed form' },
+  { value: 'other', label: 'Other' },
+]
+
+const statusVariant: Record<DocumentStatus, 'neutral' | 'success' | 'danger'> = {
+  pending_review: 'neutral',
+  verified: 'success',
+  rejected: 'danger',
+  expired: 'danger',
+}
+
+function statusLabel(status: DocumentStatus) {
+  switch (status) {
+    case 'pending_review':
+      return 'Pending'
+    case 'verified':
+      return 'Verified'
+    case 'rejected':
+      return 'Rejected'
+    case 'expired':
+      return 'Expired'
+  }
+}
+
+export function DocumentArchivePage() {
+  const { organization } = useOrganization()
+  const clerkOrgId = organization?.id
+
+  const [typeFilter, setTypeFilter] = useState<string>('all')
+  const [statusFilter, setStatusFilter] = useState<string>('all')
+  const [expiringSoon, setExpiringSoon] = useState(false)
+  const [search, setSearch] = useState('')
+  const [selectedId, setSelectedId] = useState<Id<'documentArchive'> | null>(null)
+  const [rejectingId, setRejectingId] = useState<Id<'documentArchive'> | null>(null)
+  const [rejectionReason, setRejectionReason] = useState('')
+  const [toast, setToast] = useState<{
+    variant: 'success' | 'danger'
+    message: string
+  } | null>(null)
+
+  const queryArgs = useMemo(() => {
+    if (!clerkOrgId) return 'skip'
+    const args: Record<string, unknown> = { clerkOrgId }
+    if (typeFilter !== 'all') args.type = typeFilter
+    if (statusFilter !== 'all') args.status = statusFilter
+    if (expiringSoon) args.expiringSoon = true
+    if (search.trim()) args.search = search.trim()
+    return args
+  }, [clerkOrgId, typeFilter, statusFilter, expiringSoon, search])
+
+  const items = useQuery(
+    api.documentArchive.listDocumentArchive,
+    queryArgs,
+  ) as DocumentArchiveItem[] | undefined
+
+  const updateDocument = useMutation(api.documentArchive.updateDocumentArchiveItem)
+
+  const selectedDocument = items?.find((d) => d._id === selectedId) ?? null
+
+  const handleVerify = async (doc: DocumentArchiveItem) => {
+    if (!clerkOrgId) return
+    try {
+      await updateDocument({
+        clerkOrgId,
+        documentId: doc._id,
+        status: 'verified',
+      })
+      setToast({ variant: 'success', message: 'Document verified' })
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err)
+      setToast({ variant: 'danger', message })
+    }
+  }
+
+  const openReject = (doc: DocumentArchiveItem) => {
+    setRejectingId(doc._id)
+    setRejectionReason('')
+  }
+
+  const handleReject = async () => {
+    if (!clerkOrgId || !rejectingId) return
+    try {
+      await updateDocument({
+        clerkOrgId,
+        documentId: rejectingId,
+        status: 'rejected',
+        rejectionReason: rejectionReason.trim() || undefined,
+      })
+      setRejectingId(null)
+      setRejectionReason('')
+      setToast({ variant: 'success', message: 'Document rejected' })
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err)
+      setToast({ variant: 'danger', message })
+    }
+  }
+
+  return (
+    <div className='space-y-5'>
+      {toast && (
+        <Toast
+          variant={toast.variant}
+          title={toast.message}
+          onClose={() => setToast(null)}
+        />
+      )}
+
+      <div>
+        <h1 className='text-[28px] font-bold text-atria-ink'>Document archive</h1>
+        <p className='text-base text-atria-text-secondary'>
+          Review, verify, and manage agency documents.
+        </p>
+      </div>
+
+      <div className='flex flex-wrap items-end gap-3'>
+        <div className='min-w-[160px] space-y-1'>
+          <label className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+            Document type
+          </label>
+          <Select
+            value={typeFilter}
+            onChange={(e) => setTypeFilter(e.target.value)}
+          >
+            {TYPE_OPTIONS.map((opt) => (
+              <option key={opt.value} value={opt.value}>
+                {opt.label}
+              </option>
+            ))}
+          </Select>
+        </div>
+
+        <div className='min-w-[160px] space-y-1'>
+          <label className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+            Status
+          </label>
+          <Select
+            value={statusFilter}
+            onChange={(e) => setStatusFilter(e.target.value)}
+          >
+            {STATUS_OPTIONS.map((opt) => (
+              <option key={opt.value} value={opt.value}>
+                {opt.label}
+              </option>
+            ))}
+          </Select>
+        </div>
+
+        <div className='flex items-center gap-2 pb-2'>
+          <Checkbox
+            id='expiring-soon'
+            checked={expiringSoon}
+            onCheckedChange={(checked) => setExpiringSoon(Boolean(checked))}
+          />
+          <label htmlFor='expiring-soon' className='text-base text-atria-ink'>
+            Expiring soon
+          </label>
+        </div>
+
+        <div className='min-w-[200px]'>
+          <Input
+            placeholder='Search by name'
+            value={search}
+            onChange={(e) => setSearch(e.target.value)}
+          />
+        </div>
+      </div>
+
+      {items && items.length === 0 ? (
+        <div className='rounded-lg border border-atria-border bg-white p-8 text-center'>
+          <p className='text-lg font-semibold text-atria-ink'>No documents found</p>
+          <p className='text-base text-atria-text-secondary'>
+            Try adjusting filters or upload a new document.
+          </p>
+        </div>
+      ) : (
+        <div className='overflow-x-auto rounded-lg border border-atria-border bg-white'>
+          <table className='w-full text-left'>
+            <thead className='bg-atria-bg'>
+              <tr>
+                <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Document</th>
+                <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Type</th>
+                <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Linked to</th>
+                <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Status</th>
+                <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Expires</th>
+                <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>Actions</th>
+              </tr>
+            </thead>
+            <tbody className='divide-y divide-atria-border'>
+              {items?.map((doc) => (
+                <tr key={doc._id} className='hover:bg-atria-bg'>
+                  <td className='px-4 py-3'>
+                    <button
+                      onClick={() => setSelectedId(doc._id)}
+                      className='text-base font-semibold text-atria-info hover:underline'
+                    >
+                      {doc.fileName}
+                    </button>
+                  </td>
+                  <td className='px-4 py-3 text-base capitalize text-atria-text-secondary'>
+                    {doc.documentType.replace('_', ' ')}
+                  </td>
+                  <td className='px-4 py-3 text-base text-atria-text-secondary'>
+                    {doc.linkedTo}
+                  </td>
+                  <td className='px-4 py-3'>
+                    <StatusBadge variant={statusVariant[doc.status]}>
+                      {statusLabel(doc.status)}
+                    </StatusBadge>
+                  </td>
+                  <td className='px-4 py-3 text-base text-atria-text-secondary'>
+                    {doc.expiresAt
+                      ? new Date(doc.expiresAt).toLocaleDateString()
+                      : '—'}
+                  </td>
+                  <td className='px-4 py-3'>
+                    <div className='flex items-center gap-2'>
+                      {doc.status !== 'verified' && (
+                        <Button
+                          size='sm'
+                          variant='ghost'
+                          className='text-atria-success hover:bg-atria-success/10'
+                          onClick={() => handleVerify(doc)}
+                        >
+                          Verify
+                        </Button>
+                      )}
+                      {doc.status !== 'rejected' && (
+                        <Button
+                          size='sm'
+                          variant='ghost'
+                          className='text-atria-danger hover:bg-atria-danger/10'
+                          onClick={() => openReject(doc)}
+                        >
+                          Reject
+                        </Button>
+                      )}
+                    </div>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+
+      {selectedDocument && (
+        <DocumentDetailPanel
+          document={selectedDocument}
+          onClose={() => setSelectedId(null)}
+          onVerify={handleVerify}
+          onReject={openReject}
+        />
+      )}
+
+      <Dialog open={rejectingId !== null} onClose={() => setRejectingId(null)}>
+        <DialogHeader>
+          <DialogTitle>Reject document</DialogTitle>
+        </DialogHeader>
+        <DialogContent className='space-y-4'>
+          <FieldGroup label='Reason for rejection' htmlFor='rejection-reason'>
+            <Textarea
+              id='rejection-reason'
+              value={rejectionReason}
+              onChange={(e) => setRejectionReason(e.target.value)}
+              placeholder='Enter a reason…'
+            />
+          </FieldGroup>
+          <div className='flex justify-end gap-2'>
+            <Button variant='ghost' onClick={() => setRejectingId(null)}>
+              Cancel
+            </Button>
+            <Button
+              variant='ghost'
+              className='bg-atria-danger text-white hover:bg-atria-danger/90'
+              onClick={handleReject}
+            >
+              Reject
+            </Button>
+          </div>
+        </DialogContent>
+      </Dialog>
+    </div>
+  )
+}
diff --git a/src/features/documents/pages/DocumentArchiveRoute.tsx b/src/features/documents/pages/DocumentArchiveRoute.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/documents/pages/DocumentArchiveRoute.tsx
@@ -0,0 +1,12 @@
+import { lazy, Suspense } from 'react'
+import { AppLoader } from '@/shared/ui/AppLoader'
+
+const DocumentArchivePage = lazy(() => import('./DocumentArchivePage'))
+
+export function DocumentArchiveRoute() {
+  return (
+    <Suspense fallback={<AppLoader label='Loading documents' />}>
+      <DocumentArchivePage />
+    </Suspense>
+  )
+}
diff --git a/src/features/documents/pages/DocumentArchivePage.test.tsx b/src/features/documents/pages/DocumentArchivePage.test.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/documents/pages/DocumentArchivePage.test.tsx
@@ -0,0 +1,111 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen, fireEvent, waitFor } from '@testing-library/react'
+import { MemoryRouter } from 'react-router-dom'
+import { getFunctionName } from 'convex/server'
+
+const mocks = {
+  listDocumentArchive: vi.fn(),
+  updateDocumentArchiveItem: vi.fn(),
+}
+
+vi.mock('@clerk/react', async () => {
+  const actual = await vi.importActual('@clerk/react')
+  return {
+    ...actual,
+    useOrganization: () => ({
+      organization: { id: 'org_123' },
+      isLoaded: true,
+    }),
+  }
+})
+
+vi.mock('convex/react', async () => {
+  const actual = await vi.importActual('convex/react')
+  return {
+    ...actual,
+    useQuery: vi.fn((queryRef: unknown) => {
+      const name = getFunctionName(
+        queryRef as Parameters<typeof getFunctionName>[0],
+      )
+      if (name === 'documentArchive:listDocumentArchive') {
+        return mocks.listDocumentArchive()
+      }
+      return undefined
+    }),
+    useMutation: vi.fn((mutationRef: unknown) => {
+      const name = getFunctionName(
+        mutationRef as Parameters<typeof getFunctionName>[0],
+      )
+      if (name === 'documentArchive:updateDocumentArchiveItem') {
+        return mocks.updateDocumentArchiveItem
+      }
+      return vi.fn()
+    }),
+  }
+})
+
+const documents = [
+  {
+    _id: 'doc_1',
+    fileName: 'ID.pdf',
+    documentType: 'id',
+    linkedTo: 'Lucía',
+    status: 'pending_review',
+    expiresAt: '2026-12-31',
+  },
+  {
+    _id: 'doc_2',
+    fileName: 'CPR.pdf',
+    documentType: 'certification',
+    linkedTo: 'Pedro',
+    status: 'verified',
+    verifiedBy: 'Admin',
+    verifiedAt: '2026-06-01',
+  },
+]
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  mocks.listDocumentArchive.mockReturnValue(documents)
+})
+
+describe('DocumentArchivePage', () => {
+  it('renders with filters', async () => {
+    const { DocumentArchivePage } = await import('./DocumentArchivePage')
+    render(<DocumentArchivePage />, { wrapper: MemoryRouter })
+    expect(screen.getByText('Document archive')).toBeInTheDocument()
+    expect(screen.getByText('Document type')).toBeInTheDocument()
+    expect(screen.getByText('Status')).toBeInTheDocument()
+    expect(screen.getByRole('checkbox', { name: /Expiring soon/i })).toBeInTheDocument()
+    expect(screen.getByPlaceholderText(/Search by name/i)).toBeInTheDocument()
+  })
+
+  it('calls updateDocumentArchiveItem with verified on Verify click', async () => {
+    mocks.updateDocumentArchiveItem.mockResolvedValueOnce({})
+    const { DocumentArchivePage } = await import('./DocumentArchivePage')
+    render(<DocumentArchivePage />, { wrapper: MemoryRouter })
+    const verifyButtons = screen.getAllByRole('button', { name: /Verify/i })
+    fireEvent.click(verifyButtons[0])
+    await waitFor(() => {
+      expect(mocks.updateDocumentArchiveItem).toHaveBeenCalledWith(
+        expect.objectContaining({ status: 'verified' }),
+      )
+    })
+  })
+
+  it('opens reject modal and calls updateDocumentArchiveItem with rejected and reason', async () => {
+    mocks.updateDocumentArchiveItem.mockResolvedValueOnce({})
+    const { DocumentArchivePage } = await import('./DocumentArchivePage')
+    render(<DocumentArchivePage />, { wrapper: MemoryRouter })
+    const rejectButtons = screen.getAllByRole('button', { name: /Reject/i })
+    fireEvent.click(rejectButtons[0])
+    expect(screen.getByText('Reject document')).toBeInTheDocument()
+    fireEvent.change(screen.getByLabelText(/Reason for rejection/i), {
+      target: { value: 'Missing info' },
+    })
+    fireEvent.click(screen.getByRole('button', { name: /^Reject$/i }))
+    await waitFor(() => {
+      expect(mocks.updateDocumentArchiveItem).toHaveBeenCalledWith(
+        expect.objectContaining({
+          status: 'rejected',
+          rejectionReason: 'Missing info',
+        }),
+      )
+    })
+  })
+})
diff --git a/src/features/forms/components/DynamicFormRenderer.tsx b/src/features/forms/components/DynamicFormRenderer.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/components/DynamicFormRenderer.tsx
@@ -0,0 +1,181 @@
+import { useState } from 'react'
+import { Button } from '@/shared/ui/Button'
+import { Checkbox } from '@/shared/ui/Checkbox'
+import { FieldGroup } from '@/shared/ui/FieldGroup'
+import { Input } from '@/shared/ui/Input'
+import { Select } from '@/shared/ui/Select'
+import { Textarea } from '@/shared/ui/Textarea'
+
+export type FormField = {
+  id: string
+  type: 'text' | 'textarea' | 'select' | 'checkbox' | 'date' | 'number'
+  label: string
+  helperText?: string
+  required?: boolean
+  options?: Array<{ value: string; label: string }>
+  placeholder?: string
+}
+
+type DynamicFormRendererProps = {
+  formDefinition: {
+    id: string
+    name: string
+    fields: FormField[]
+  }
+  onSubmit: (data: Record<string, unknown>) => void
+  loading?: boolean
+  existingData?: Record<string, unknown>
+}
+
+function isEmpty(value: unknown) {
+  if (value === undefined || value === null) return true
+  if (typeof value === 'string' && value.trim() === '') return true
+  return false
+}
+
+export function DynamicFormRenderer({
+  formDefinition,
+  onSubmit,
+  loading,
+  existingData,
+}: DynamicFormRendererProps) {
+  const [data, setData] = useState<Record<string, unknown>>(() => ({
+    ...existingData,
+  }))
+  const [errors, setErrors] = useState<Record<string, string>>({})
+
+  const setField = (id: string, value: unknown) => {
+    setData((prev) => ({ ...prev, [id]: value }))
+    setErrors((prev) => ({ ...prev, [id]: '' }))
+  }
+
+  const handleSubmit = (e: React.FormEvent) => {
+    e.preventDefault()
+    const nextErrors: Record<string, string> = {}
+    for (const field of formDefinition.fields) {
+      if (!field.required) continue
+      const value = data[field.id]
+      const missing =
+        field.type === 'checkbox' ? value !== true : isEmpty(value)
+      if (missing) {
+        nextErrors[field.id] = 'This field is required'
+      }
+    }
+    if (Object.keys(nextErrors).length > 0) {
+      setErrors(nextErrors)
+      return
+    }
+    onSubmit(data)
+  }
+
+  return (
+    <form onSubmit={handleSubmit} className='space-y-5'>
+      <h1 className='text-[28px] font-bold text-atria-ink'>{formDefinition.name}</h1>
+      {formDefinition.fields.map((field) => {
+        const error = errors[field.id]
+
+        return (
+          <div key={field.id} className='space-y-1'>
+            {field.type === 'text' && (
+              <FieldGroup
+                label={field.label}
+                htmlFor={field.id}
+                required={field.required}
+                error={error}
+                helperText={field.helperText}
+              >
+                <Input
+                  id={field.id}
+                  type='text'
+                  value={(data[field.id] as string) ?? ''}
+                  placeholder={field.placeholder}
+                  onChange={(e) => setField(field.id, e.target.value)}
+                />
+              </FieldGroup>
+            )}
+            {field.type === 'textarea' && (
+              <FieldGroup
+                label={field.label}
+                htmlFor={field.id}
+                required={field.required}
+                error={error}
+              >
+                <Textarea
+                  id={field.id}
+                  value={(data[field.id] as string) ?? ''}
+                  placeholder={field.placeholder}
+                  onChange={(e) => setField(field.id, e.target.value)}
+                />
+              </FieldGroup>
+            )}
+            {field.type === 'select' && (
+              <FieldGroup
+                label={field.label}
+                htmlFor={field.id}
+                required={field.required}
+                error={error}
+              >
+                <Select
+                  id={field.id}
+                  value={(data[field.id] as string) ?? ''}
+                  onChange={(e) => setField(field.id, e.target.value)}
+                >
+                  <option value=''>Select…</option>
+                  {field.options?.map((opt) => (
+                    <option key={opt.value} value={opt.value}>
+                      {opt.label}
+                    </option>
+                  ))}
+                </Select>
+              </FieldGroup>
+            )}
+            {field.type === 'checkbox' && (
+              <FieldGroup
+                label={field.label}
+                htmlFor={field.id}
+                required={field.required}
+                error={error}
+                helperText={field.helperText}
+              >
+                <div className='flex items-center gap-2'>
+                  <Checkbox
+                    id={field.id}
+                    checked={Boolean(data[field.id])}
+                    onCheckedChange={(checked) =>
+                      setField(field.id, Boolean(checked))
+                    }
+                  />
+                </div>
+              </FieldGroup>
+            )}
+            {field.type === 'date' && (
+              <FieldGroup
+                label={field.label}
+                htmlFor={field.id}
+                required={field.required}
+                error={error}
+              >
+                <Input
+                  id={field.id}
+                  type='date'
+                  value={(data[field.id] as string) ?? ''}
+                  onChange={(e) => setField(field.id, e.target.value)}
+                />
+              </FieldGroup>
+            )}
+            {field.type === 'number' && (
+              <FieldGroup
+                label={field.label}
+                htmlFor={field.id}
+                required={field.required}
+                error={error}
+              >
+                <Input
+                  id={field.id}
+                  type='number'
+                  value={(data[field.id] as number) ?? ''}
+                  onChange={(e) =>
+                    setField(
+                      field.id,
+                      e.target.value === '' ? '' : Number(e.target.value),
+                    )
+                  }
+                />
+              </FieldGroup>
+            )}
+          </div>
+        )
+      })}
+      <Button type='submit' disabled={loading} className='w-full sm:w-auto'>
+        {loading ? 'Submitting…' : 'Submit'}
+      </Button>
+    </form>
+  )
+}
diff --git a/src/features/forms/components/DynamicFormRenderer.test.tsx b/src/features/forms/components/DynamicFormRenderer.test.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/components/DynamicFormRenderer.test.tsx
@@ -0,0 +1,86 @@
+import { describe, it, expect, vi } from 'vitest'
+import { render, screen, fireEvent } from '@testing-library/react'
+import {
+  DynamicFormRenderer,
+  type FormField,
+} from './DynamicFormRenderer'
+
+const fields: FormField[] = [
+  { id: 'name', type: 'text', label: 'Full name', required: true },
+  { id: 'bio', type: 'textarea', label: 'Bio' },
+  {
+    id: 'role',
+    type: 'select',
+    label: 'Role',
+    required: true,
+    options: [{ value: 'cg', label: 'Caregiver' }],
+  },
+  { id: 'agree', type: 'checkbox', label: 'Agree', required: true },
+  { id: 'dob', type: 'date', label: 'Date of birth', required: true },
+  { id: 'years', type: 'number', label: 'Years', required: true },
+]
+
+describe('DynamicFormRenderer', () => {
+  it('renders all field types', () => {
+    render(
+      <DynamicFormRenderer
+        formDefinition={{ id: 'f1', name: 'Test', fields }}
+        onSubmit={vi.fn()}
+      />,
+    )
+    expect(screen.getByLabelText(/Full name/i)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Bio/i)).toBeInTheDocument()
+    expect(screen.getByRole('combobox', { name: /Role/i })).toBeInTheDocument()
+    expect(screen.getByRole('checkbox', { name: /Agree/i })).toBeInTheDocument()
+    expect(screen.getByLabelText(/Date of birth/i)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Years/i)).toBeInTheDocument()
+  })
+
+  it('shows required validation errors and does not submit when invalid', () => {
+    const onSubmit = vi.fn()
+    render(
+      <DynamicFormRenderer
+        formDefinition={{ id: 'f1', name: 'Test', fields }}
+        onSubmit={onSubmit}
+      />,
+    )
+    fireEvent.click(screen.getByRole('button', { name: /Submit/i }))
+    expect(
+      screen.getAllByText(/This field is required/i).length,
+    ).toBeGreaterThan(0)
+    expect(onSubmit).not.toHaveBeenCalled()
+  })
+
+  it('calls onSubmit with data when valid', () => {
+    const onSubmit = vi.fn()
+    render(
+      <DynamicFormRenderer
+        formDefinition={{ id: 'f1', name: 'Test', fields }}
+        onSubmit={onSubmit}
+      />,
+    )
+    fireEvent.change(screen.getByLabelText(/Full name/i), {
+      target: { value: 'Jane' },
+    })
+    fireEvent.change(screen.getByRole('combobox', { name: /Role/i }), {
+      target: { value: 'cg' },
+    })
+    fireEvent.click(screen.getByRole('checkbox', { name: /Agree/i }))
+    fireEvent.change(screen.getByLabelText(/Date of birth/i), {
+      target: { value: '1990-01-01' },
+    })
+    fireEvent.change(screen.getByLabelText(/Years/i), {
+      target: { value: '5' },
+    })
+    fireEvent.click(screen.getByRole('button', { name: /Submit/i }))
+    expect(onSubmit).toHaveBeenCalledWith(
+      expect.objectContaining({
+        name: 'Jane',
+        role: 'cg',
+        agree: true,
+        dob: '1990-01-01',
+        years: 5,
+      }),
+    )
+  })
+})
diff --git a/src/features/forms/pages/FormSubmissionPage.tsx b/src/features/forms/pages/FormSubmissionPage.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/pages/FormSubmissionPage.tsx
@@ -0,0 +1,76 @@
+import { useState } from 'react'
+import { useOrganization } from '@clerk/react'
+import { useMutation, useQuery } from 'convex/react'
+import { useNavigate, useParams } from 'react-router-dom'
+import { api } from '../../../convex/_generated/api'
+import { AppLoader } from '@/shared/ui/AppLoader'
+import { Toast } from '@/shared/ui/Toast'
+import { DynamicFormRenderer } from '../components/DynamicFormRenderer'
+import type { FormField } from '../components/DynamicFormRenderer'
+
+type FormDefinition = {
+  _id: string
+  name: string
+  fields: FormField[]
+}
+
+export function FormSubmissionPage() {
+  const { formDefinitionId } = useParams<{ formDefinitionId: string }>()
+  const navigate = useNavigate()
+  const { organization } = useOrganization()
+  const clerkOrgId = organization?.id
+  const role = organization?.membership?.role
+
+  const [toast, setToast] = useState<{
+    variant: 'success' | 'danger'
+    message: string
+  } | null>(null)
+  const [submitting, setSubmitting] = useState(false)
+
+  const definitions = useQuery(
+    api.forms.listFormDefinitions,
+    clerkOrgId ? { clerkOrgId } : 'skip',
+  ) as FormDefinition[] | undefined
+
+  const definition = definitions?.find((d) => d._id === formDefinitionId)
+
+  const submitForm = useMutation(api.forms.submitForm)
+
+  const handleSubmit = async (data: Record<string, unknown>) => {
+    if (!clerkOrgId || !formDefinitionId) return
+    setSubmitting(true)
+    try {
+      await submitForm({ clerkOrgId, formDefinitionId, data })
+      setToast({ variant: 'success', message: 'Form submitted' })
+      if (role === 'org:candidate') {
+        navigate('/onboarding')
+      } else {
+        navigate(-1)
+      }
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err)
+      setToast({ variant: 'danger', message })
+    } finally {
+      setSubmitting(false)
+    }
+  }
+
+  if (definitions === undefined) {
+    return <AppLoader label='Loading form' />
+  }
+
+  if (!definition) {
+    return (
+      <div className='rounded-lg border border-atria-border bg-white p-8 text-center'>
+        <p className='text-lg font-semibold text-atria-ink'>Form not found</p>
+      </div>
+    )
+  }
+
+  return (
+    <div className='mx-auto max-w-2xl p-4'>
+      {toast && (
+        <Toast
+          variant={toast.variant}
+          title={toast.message}
+          onClose={() => setToast(null)}
+        />
+      )}
+      <DynamicFormRenderer
+        formDefinition={definition}
+        onSubmit={handleSubmit}
+        loading={submitting}
+      />
+    </div>
+  )
+}
diff --git a/src/features/forms/pages/FormSubmissionPage.test.tsx b/src/features/forms/pages/FormSubmissionPage.test.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/pages/FormSubmissionPage.test.tsx
@@ -0,0 +1,82 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen, fireEvent, waitFor } from '@testing-library/react'
+import { MemoryRouter, Routes, Route } from 'react-router-dom'
+import { getFunctionName } from 'convex/server'
+
+const mocks = {
+  listFormDefinitions: vi.fn(),
+  submitForm: vi.fn(),
+}
+
+vi.mock('@clerk/react', async () => {
+  const actual = await vi.importActual('@clerk/react')
+  return {
+    ...actual,
+    useOrganization: () => ({
+      organization: {
+        id: 'org_123',
+        membership: { role: 'org:candidate' },
+      },
+      isLoaded: true,
+    }),
+  }
+})
+
+vi.mock('convex/react', async () => {
+  const actual = await vi.importActual('convex/react')
+  return {
+    ...actual,
+    useQuery: vi.fn((queryRef: unknown) => {
+      const name = getFunctionName(
+        queryRef as Parameters<typeof getFunctionName>[0],
+      )
+      if (name === 'forms:listFormDefinitions') {
+        return mocks.listFormDefinitions()
+      }
+      return undefined
+    }),
+    useMutation: vi.fn((mutationRef: unknown) => {
+      const name = getFunctionName(
+        mutationRef as Parameters<typeof getFunctionName>[0],
+      )
+      if (name === 'forms:submitForm') {
+        return mocks.submitForm
+      }
+      return vi.fn()
+    }),
+  }
+})
+
+const formDefinition = {
+  _id: 'form_1',
+  name: 'Application',
+  fields: [{ id: 'name', type: 'text', label: 'Name', required: true }],
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  mocks.listFormDefinitions.mockReturnValue([formDefinition])
+  mocks.submitForm.mockResolvedValue({ submissionId: 'sub_1' })
+})
+
+describe('FormSubmissionPage', () => {
+  it('fetches form definition and calls submitForm', async () => {
+    const { FormSubmissionPage } = await import('./FormSubmissionPage')
+    render(
+      <MemoryRouter initialEntries={['/forms/form_1']}>
+        <Routes>
+          <Route
+            path='/forms/:formDefinitionId'
+            element={<FormSubmissionPage />}
+          />
+          <Route path='/onboarding' element={<div>Onboarding</div>} />
+        </Routes>
+      </MemoryRouter>,
+    )
+    expect(await screen.findByText('Application')).toBeInTheDocument()
+    fireEvent.change(screen.getByLabelText(/Name/i), {
+      target: { value: 'Jane' },
+    })
+    fireEvent.click(screen.getByRole('button', { name: /Submit/i }))
+    await waitFor(() => {
+      expect(mocks.submitForm).toHaveBeenCalledWith(
+        expect.objectContaining({
+          formDefinitionId: 'form_1',
+          data: { name: 'Jane' },
+        }),
+      )
+    })
+    expect(screen.getByText('Onboarding')).toBeInTheDocument()
+  })
+})
