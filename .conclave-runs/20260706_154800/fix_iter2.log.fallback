diff --git a/src/features/forms/components/DynamicFormRenderer.tsx b/src/features/forms/components/DynamicFormRenderer.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/components/DynamicFormRenderer.tsx
@@ -0,0 +1,213 @@
+import { useCallback, useState } from 'react'
+import { Button } from '@/shared/ui/Button'
+import { Checkbox } from '@/shared/ui/Checkbox'
+import { FieldGroup } from '@/shared/ui/FieldGroup'
+import { Input } from '@/shared/ui/Input'
+import { Select } from '@/shared/ui/Select'
+import { Textarea } from '@/shared/ui/Textarea'
+
+export type FormFieldOption = {
+  value: string
+  label: string
+}
+
+export type FormField = {
+  id: string
+  type: 'text' | 'textarea' | 'select' | 'checkbox' | 'date' | 'number'
+  label: string
+  helperText?: string
+  options?: FormFieldOption[]
+  required?: boolean
+}
+
+export type FormDefinition = {
+  id: string
+  name: string
+  fields: FormField[]
+}
+
+type DynamicFormRendererProps = {
+  formDefinition: FormDefinition
+  onSubmit: (data: Record<string, unknown>) => void
+  loading?: boolean
+  existingData?: Record<string, unknown>
+}
+
+function isEmpty(value: unknown): boolean {
+  if (value === undefined || value === null) return true
+  if (typeof value === 'string' && value.trim() === '') return true
+  if (typeof value === 'number' && Number.isNaN(value)) return true
+  return false
+}
+
+export function DynamicFormRenderer({
+  formDefinition,
+  onSubmit,
+  loading = false,
+  existingData,
+}: DynamicFormRendererProps) {
+  const [formData, setFormData] = useState<Record<string, unknown>>(() => {
+    const initial: Record<string, unknown> = {}
+    formDefinition.fields.forEach((field) => {
+      const existing = existingData?.[field.id]
+      if (existing !== undefined) {
+        initial[field.id] = existing
+      } else if (field.type === 'checkbox') {
+        initial[field.id] = false
+      } else {
+        initial[field.id] = ''
+      }
+    })
+    return initial
+  })
+
+  const [errors, setErrors] = useState<Record<string, string>>({})
+
+  const updateField = useCallback((id: string, value: unknown) => {
+    setFormData((prev) => ({ ...prev, [id]: value }))
+    setErrors((prev) => {
+      if (!prev[id]) return prev
+      const next = { ...prev }
+      delete next[id]
+      return next
+    })
+  }, [])
+
+  const handleSubmit = useCallback(() => {
+    const nextErrors: Record<string, string> = {}
+    formDefinition.fields.forEach((field) => {
+      if (!field.required) return
+      const value = formData[field.id]
+      if (field.type === 'checkbox') {
+        if (value !== true) {
+          nextErrors[field.id] = 'This field is required.'
+        }
+      } else if (isEmpty(value)) {
+        nextErrors[field.id] = 'This field is required.'
+      }
+    })
+
+    if (Object.keys(nextErrors).length > 0) {
+      setErrors(nextErrors)
+      return
+    }
+
+    onSubmit(formData)
+  }, [formDefinition.fields, formData, onSubmit])
+
+  return (
+    <form
+      className='space-y-5'
+      data-testid='dynamic-form'
+      onSubmit={(e) => {
+        e.preventDefault()
+        handleSubmit()
+      }}
+    >
+      <h1 className='text-[28px] font-bold text-atria-ink'>{formDefinition.name}</h1>
+      {formDefinition.fields.map((field) => (
+        <DynamicField
+          key={field.id}
+          error={errors[field.id]}
+          field={field}
+          onChange={(value) => updateField(field.id, value)}
+          value={formData[field.id]}
+        />
+      ))}
+      <Button
+        className='w-full sm:w-auto'
+        disabled={loading}
+        size='lg'
+        type='submit'
+        variant='primary'
+      >
+        {loading ? 'Submitting…' : 'Submit'}
+      </Button>
+    </form>
+  )
+}
+
+function DynamicField({
+  field,
+  value,
+  error,
+  onChange,
+}: {
+  field: FormField
+  value: unknown
+  error?: string
+  onChange: (value: unknown) => void
+}) {
+  const { id, type, label, helperText, options, required } = field
+
+  return (
+    <div className='space-y-1'>
+      {type === 'checkbox' ? (
+        <Checkbox
+          checked={Boolean(value)}
+          id={id}
+          label={label}
+          onChange={(e) => onChange(e.target.checked)}
+        />
+      ) : (
+        <FieldGroup htmlFor={id} label={label} required={required}>
+          {helperText && (
+            <p className='text-sm text-atria-text-secondary'>{helperText}</p>
+          )}
+          {type === 'text' && (
+            <Input
+              id={id}
+              onChange={(e) => onChange(e.target.value)}
+              type='text'
+              value={String(value ?? '')}
+            />
+          )}
+          {type === 'textarea' && (
+            <Textarea
+              id={id}
+              onChange={(e) => onChange(e.target.value)}
+              rows={4}
+              value={String(value ?? '')}
+            />
+          )}
+          {type === 'select' && (
+            <Select
+              id={id}
+              onChange={(e) => onChange(e.target.value)}
+              value={String(value ?? '')}
+            >
+              <option value=''>Select an option</option>
+              {options?.map((option) => (
+                <option key={option.value} value={option.value}>
+                  {option.label}
+                </option>
+              ))}
+            </Select>
+          )}
+          {type === 'date' && (
+            <Input
+              id={id}
+              onChange={(e) => onChange(e.target.value)}
+              type='date'
+              value={String(value ?? '')}
+            />
+          )}
+          {type === 'number' && (
+            <Input
+              id={id}
+              onChange={(e) =>
+                onChange(e.target.value === '' ? '' : Number(e.target.value))
+              }
+              type='number'
+              value={String(value ?? '')}
+            />
+          )}
+        </FieldGroup>
+      )}
+      {error && <p className='text-sm text-atria-danger'>{error}</p>}
+    </div>
+  )
+}
diff --git a/src/features/forms/pages/FormSubmissionPage.tsx b/src/features/forms/pages/FormSubmissionPage.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/pages/FormSubmissionPage.tsx
@@ -0,0 +1,103 @@
+import { useMemo, useState } from 'react'
+import { Navigate, useNavigate } from 'react-router-dom'
+import { useOrganization, useUser } from '@clerk/react'
+import { useMutation, useQuery } from 'convex/react'
+import { api } from '../../../../convex/_generated/api'
+import type { Id } from '../../../../convex/_generated/dataModel'
+import { AppLoader } from '@/shared/ui/AppLoader'
+import { Card, CardContent } from '@/shared/ui/Card'
+import { Toast } from '@/shared/ui/Toast'
+import { DynamicFormRenderer } from '../components/DynamicFormRenderer'
+
+type MemberRole =
+  | 'org:admin'
+  | 'org:hr'
+  | 'org:coordinator'
+  | 'org:caregiver'
+  | 'org:candidate'
+
+export function FormSubmissionPage() {
+  const navigate = useNavigate()
+  const { organization, isLoaded: orgLoaded } = useOrganization()
+  const { user, isLoaded: userLoaded } = useUser()
+  const clerkOrgId = organization?.id
+
+  const member = useQuery(
+    api.members.me,
+    clerkOrgId ? { clerkOrgId } : 'skip',
+  )
+
+  const definitions = useQuery(
+    api.forms.listFormDefinitions,
+    clerkOrgId ? { clerkOrgId } : 'skip',
+  )
+
+  const submitForm = useMutation(api.forms.submitForm)
+
+  const [submitting, setSubmitting] = useState(false)
+  const [toast, setToast] = useState<{
+    variant: 'success' | 'danger'
+    message: string
+  } | null>(null)
+
+  const formDefinition = useMemo(() => {
+    if (!definitions) return undefined
+    const id = window.location.pathname.split('/').pop()
+    return definitions.find(
+      (d) => d._id === id || (d as { id?: string }).id === id,
+    )
+  }, [definitions])
+
+  if (!orgLoaded || !userLoaded || member === undefined || definitions === undefined) {
+    return <AppLoader label='Loading form' />
+  }
+
+  if (!organization || !user || member === null) {
+    return <Navigate replace to='/sign-in' />
+  }
+
+  if (!formDefinition) {
+    return (
+      <Card>
+        <CardContent className='p-6'>
+          <p className='text-base text-atria-text-secondary'>Form not found.</p>
+        </CardContent>
+      </Card>
+    )
+  }
+
+  const role = member.role as MemberRole
+
+  const handleSubmit = async (data: Record<string, unknown>) => {
+    if (!clerkOrgId) return
+    setSubmitting(true)
+    setToast(null)
+    try {
+      await submitForm({
+        clerkOrgId,
+        data,
+        formDefinitionId: formDefinition._id as Id<'formDefinitions'>,
+      })
+      setToast({ variant: 'success', message: 'Form submitted' })
+      navigate(role === 'org:candidate' ? '/onboarding' : -1)
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err)
+      setToast({ variant: 'danger', message })
+    } finally {
+      setSubmitting(false)
+    }
+  }
+
+  return (
+    <div className='mx-auto max-w-2xl p-4'>
+      {toast && (
+        <Toast
+          onClose={() => setToast(null)}
+          title={toast.message}
+          variant={toast.variant}
+        />
+      )}
+      <Card>
+        <CardContent className='p-6'>
+          <DynamicFormRenderer
+            formDefinition={{
+              fields: formDefinition.fields,
+              id: formDefinition._id,
+              name: formDefinition.name,
+            }}
+            loading={submitting}
+            onSubmit={handleSubmit}
+          />
+        </CardContent>
+      </Card>
+    </div>
+  )
+}
diff --git a/src/features/documents/pages/DocumentArchivePage.tsx b/src/features/documents/pages/DocumentArchivePage.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/documents/pages/DocumentArchivePage.tsx
@@ -0,0 +1,313 @@
+import { useCallback, useMemo, useState } from 'react'
+import { useOrganization } from '@clerk/react'
+import { useMutation, useQuery } from 'convex/react'
+import { api } from '../../../../convex/_generated/api'
+import type { Id } from '../../../../convex/_generated/dataModel'
+import { AppLoader } from '@/shared/ui/AppLoader'
+import { Button } from '@/shared/ui/Button'
+import { Card, CardContent } from '@/shared/ui/Card'
+import { Checkbox } from '@/shared/ui/Checkbox'
+import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/shared/ui/Dialog'
+import { FieldGroup } from '@/shared/ui/FieldGroup'
+import { Input } from '@/shared/ui/Input'
+import { Select } from '@/shared/ui/Select'
+import { StatusBadge } from '@/shared/ui/StatusBadge'
+import { Textarea } from '@/shared/ui/Textarea'
+import { Toast } from '@/shared/ui/Toast'
+import { DocumentDetailPanel } from '../components/DocumentDetailPanel'
+
+const DOCUMENT_TYPES = [
+  { label: 'All', value: 'all' },
+  { label: 'ID', value: 'id' },
+  { label: 'Certification', value: 'certification' },
+  { label: 'Signed form', value: 'signed_form' },
+  { label: 'Other', value: 'other' },
+]
+
+const STATUS_OPTIONS = [
+  { label: 'All', value: 'all' },
+  { label: 'Pending', value: 'pending_review' },
+  { label: 'Verified', value: 'verified' },
+  { label: 'Rejected', value: 'rejected' },
+  { label: 'Expired', value: 'expired' },
+]
+
+const STATUS_CONFIG = {
+  expired: { label: 'Expired', variant: 'danger' as const },
+  pending_review: { label: 'Pending', variant: 'neutral' as const },
+  rejected: { label: 'Rejected', variant: 'danger' as const },
+  verified: { label: 'Verified', variant: 'success' as const },
+}
+
+type DocumentStatus = keyof typeof STATUS_CONFIG
+
+type DocumentArchiveItem = {
+  _id: Id<'documentArchiveItems'>
+  documentType: string
+  downloadUrl?: string
+  expiresAt?: string
+  fileName: string
+  linkedToName: string
+  rejectionReason?: string
+  status: DocumentStatus
+  verifiedAt?: string
+  verifiedBy?: string
+}
+
+function formatExpiry(iso?: string): string {
+  if (!iso) return '—'
+  return new Date(iso).toLocaleDateString()
+}
+
+export function DocumentArchivePage() {
+  const { organization } = useOrganization()
+  const clerkOrgId = organization?.id
+
+  const items = useQuery(
+    api.documentArchive.listDocumentArchive,
+    clerkOrgId
+      ? {
+          clerkOrgId,
+          expiringSoon,
+          search: search.trim() || undefined,
+          status: statusFilter === 'all' ? undefined : statusFilter,
+          type: typeFilter === 'all' ? undefined : typeFilter,
+        }
+      : 'skip',
+  )
+
+  const updateDocumentArchiveItem = useMutation(
+    api.documentArchive.updateDocumentArchiveItem,
+  )
+
+  const [typeFilter, setTypeFilter] = useState('all')
+  const [statusFilter, setStatusFilter] = useState('all')
+  const [expiringSoon, setExpiringSoon] = useState(false)
+  const [search, setSearch] = useState('')
+  const [selectedItem, setSelectedItem] = useState<DocumentArchiveItem | null>(null)
+  const [rejectingItem, setRejectingItem] = useState<DocumentArchiveItem | null>(null)
+  const [rejectionReason, setRejectionReason] = useState('')
+  const [optimisticItems, setOptimisticItems] = useState<DocumentArchiveItem[] | null>(null)
+  const [actingId, setActingId] = useState<Id<'documentArchiveItems'> | null>(null)
+  const [toast, setToast] = useState<{
+    variant: 'success' | 'danger'
+    message: string
+  } | null>(null)
+
+  const displayItems = useMemo(() => {
+    return optimisticItems ?? items ?? []
+  }, [optimisticItems, items])
+
+  const handleVerify = useCallback(
+    async (item: DocumentArchiveItem) => {
+      if (!clerkOrgId || actingId) return
+      setActingId(item._id)
+      setOptimisticItems((prev) => {
+        const base = prev ?? items ?? []
+        return base.map((i) =>
+          i._id === item._id ? { ...i, status: 'verified' as const } : i,
+        )
+      })
+      setToast(null)
+      try {
+        await updateDocumentArchiveItem({
+          clerkOrgId,
+          itemId: item._id,
+          status: 'verified',
+        })
+        setToast({ variant: 'success', message: 'Document verified' })
+      } catch (err) {
+        const message = err instanceof Error ? err.message : String(err)
+        setToast({ variant: 'danger', message })
+        setOptimisticItems(null)
+      } finally {
+        setActingId(null)
+      }
+    },
+    [clerkOrgId, actingId, items, updateDocumentArchiveItem],
+  )
+
+  const openRejectModal = useCallback((item: DocumentArchiveItem) => {
+    setRejectingItem(item)
+    setRejectionReason(item.rejectionReason ?? '')
+  }, [])
+
+  const handleRejectConfirm = useCallback(async () => {
+    if (!clerkOrgId || !rejectingItem) return
+    setActingId(rejectingItem._id)
+    setToast(null)
+    try {
+      await updateDocumentArchiveItem({
+        clerkOrgId,
+        itemId: rejectingItem._id,
+        rejectionReason,
+        status: 'rejected',
+      })
+      setToast({ variant: 'success', message: 'Document rejected' })
+      setRejectingItem(null)
+      setRejectionReason('')
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err)
+      setToast({ variant: 'danger', message })
+    } finally {
+      setActingId(null)
+    }
+  }, [clerkOrgId, rejectingItem, rejectionReason, updateDocumentArchiveItem])
+
+  if (items === undefined) {
+    return <AppLoader label='Loading documents' />
+  }
+
+  return (
+    <div className='space-y-5'>
+      {toast && (
+        <Toast
+          onClose={() => setToast(null)}
+          title={toast.message}
+          variant={toast.variant}
+        />
+      )}
+      <h1 className='text-[28px] font-bold text-atria-ink'>Document archive</h1>
+      <Card>
+        <CardContent className='flex flex-wrap items-end gap-4 p-5'>
+          <FieldGroup htmlFor='type-filter' label='Document type'>
+            <Select
+              id='type-filter'
+              onChange={(e) => setTypeFilter(e.target.value)}
+              value={typeFilter}
+            >
+              {DOCUMENT_TYPES.map((t) => (
+                <option key={t.value} value={t.value}>
+                  {t.label}
+                </option>
+              ))}
+            </Select>
+          </FieldGroup>
+          <FieldGroup htmlFor='status-filter' label='Status'>
+            <Select
+              id='status-filter'
+              onChange={(e) => setStatusFilter(e.target.value)}
+              value={statusFilter}
+            >
+              {STATUS_OPTIONS.map((s) => (
+                <option key={s.value} value={s.value}>
+                  {s.label}
+                </option>
+              ))}
+            </Select>
+          </FieldGroup>
+          <FieldGroup htmlFor='entity-search' label='Search by name'>
+            <Input
+              id='entity-search'
+              onChange={(e) => setSearch(e.target.value)}
+              placeholder='Search linked name…'
+              type='text'
+              value={search}
+            />
+          </FieldGroup>
+          <div className='flex items-center gap-2 pb-2'>
+            <Checkbox
+              checked={expiringSoon}
+              id='expiring-soon'
+              label='Expiring soon'
+              onChange={(e) => setExpiringSoon(e.target.checked)}
+            />
+          </div>
+        </CardContent>
+      </Card>
+      {displayItems.length === 0 ? (
+        <Card>
+          <CardContent className='p-6'>
+            <p className='text-base text-atria-text-secondary'>
+              No documents match your filters.
+            </p>
+          </CardContent>
+        </Card>
+      ) : (
+        <Card>
+          <div className='overflow-x-auto'>
+            <table className='w-full text-left'>
+              <thead className='bg-atria-surface'>
+                <tr>
+                  <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+                    Document
+                  </th>
+                  <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+                    Type
+                  </th>
+                  <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+                    Linked to
+                  </th>
+                  <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+                    Status
+                  </th>
+                  <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+                    Expires
+                  </th>
+                  <th className='px-4 py-3 text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+                    Actions
+                  </th>
+                </tr>
+              </thead>
+              <tbody className='divide-y divide-atria-border'>
+                {displayItems.map((item) => (
+                  <tr key={item._id}>
+                    <td className='px-4 py-3'>
+                      <button
+                        className='text-base font-semibold text-atria-info hover:underline'
+                        onClick={() => setSelectedItem(item)}
+                      >
+                        {item.fileName}
+                      </button>
+                    </td>
+                    <td className='px-4 py-3 text-base text-atria-text-secondary'>
+                      {DOCUMENT_TYPES.find((t) => t.value === item.documentType)
+                        ?.label ?? item.documentType}
+                    </td>
+                    <td className='px-4 py-3 text-base text-atria-text-secondary'>
+                      {item.linkedToName}
+                    </td>
+                    <td className='px-4 py-3'>
+                      <StatusBadge variant={STATUS_CONFIG[item.status].variant}>
+                        {STATUS_CONFIG[item.status].label}
+                      </StatusBadge>
+                    </td>
+                    <td className='px-4 py-3 text-base text-atria-text-secondary'>
+                      {formatExpiry(item.expiresAt)}
+                    </td>
+                    <td className='px-4 py-3'>
+                      <div className='flex items-center gap-2'>
+                        {item.status !== 'verified' && (
+                          <Button
+                            className='text-atria-success hover:bg-atria-success/10'
+                            disabled={actingId === item._id}
+                            onClick={() => handleVerify(item)}
+                            size='sm'
+                            variant='ghost'
+                          >
+                            Verify
+                          </Button>
+                        )}
+                        {item.status !== 'rejected' && (
+                          <Button
+                            className='text-atria-danger hover:bg-atria-danger/10'
+                            disabled={actingId === item._id}
+                            onClick={() => openRejectModal(item)}
+                            size='sm'
+                            variant='ghost'
+                          >
+                            Reject
+                          </Button>
+                        )}
+                      </div>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+        </Card>
+      )}
+      {selectedItem && (
+        <DocumentDetailPanel
+          clerkOrgId={clerkOrgId}
+          item={selectedItem}
+          onClose={() => setSelectedItem(null)}
+        />
+      )}
+      {rejectingItem && (
+        <Dialog
+          className='max-w-lg'
+          onClose={() => setRejectingItem(null)}
+          open
+        >
+          <DialogHeader>
+            <DialogTitle>Reject document</DialogTitle>
+          </DialogHeader>
+          <DialogContent className='space-y-4 p-6'>
+            <p className='text-base text-atria-text-secondary'>
+              Provide a reason for rejecting{' '}
+              <strong>{rejectingItem.fileName}</strong>.
+            </p>
+            <FieldGroup
+              htmlFor='rejection-reason'
+              label='Rejection reason'
+              required
+            >
+              <Textarea
+                id='rejection-reason'
+                onChange={(e) => setRejectionReason(e.target.value)}
+                rows={4}
+                value={rejectionReason}
+              />
+            </FieldGroup>
+          </DialogContent>
+          <div className='flex justify-end gap-2 border-t border-atria-border p-4'>
+            <Button
+              onClick={() => setRejectingItem(null)}
+              variant='ghost'
+            >
+              Cancel
+            </Button>
+            <Button
+              disabled={
+                !rejectionReason.trim() || actingId === rejectingItem._id
+              }
+              onClick={handleRejectConfirm}
+              variant='danger'
+            >
+              {actingId === rejectingItem._id ? 'Rejecting…' : 'Reject'}
+            </Button>
+          </div>
+        </Dialog>
+      )}
+    </div>
+  )
+}
diff --git a/src/features/documents/components/DocumentDetailPanel.tsx b/src/features/documents/components/DocumentDetailPanel.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/documents/components/DocumentDetailPanel.tsx
@@ -0,0 +1,196 @@
+import { useCallback, useState } from 'react'
+import { useMutation } from 'convex/react'
+import { api } from '../../../../convex/_generated/api'
+import type { Id } from '../../../../convex/_generated/dataModel'
+import { Button } from '@/shared/ui/Button'
+import { FieldGroup } from '@/shared/ui/FieldGroup'
+import { StatusBadge } from '@/shared/ui/StatusBadge'
+import { Textarea } from '@/shared/ui/Textarea'
+import { Toast } from '@/shared/ui/Toast'
+import { X } from 'lucide-react'
+
+type DocumentStatus = 'expired' | 'pending_review' | 'rejected' | 'verified'
+
+type DocumentArchiveItem = {
+  _id: Id<'documentArchiveItems'>
+  documentType: string
+  downloadUrl?: string
+  expiresAt?: string
+  fileName: string
+  linkedToName: string
+  rejectionReason?: string
+  status: DocumentStatus
+  verifiedAt?: string
+  verifiedBy?: string
+}
+
+const STATUS_CONFIG = {
+  expired: { label: 'Expired', variant: 'danger' as const },
+  pending_review: { label: 'Pending', variant: 'neutral' as const },
+  rejected: { label: 'Rejected', variant: 'danger' as const },
+  verified: { label: 'Verified', variant: 'success' as const },
+}
+
+type DocumentDetailPanelProps = {
+  clerkOrgId?: string
+  item: DocumentArchiveItem
+  onClose: () => void
+}
+
+export function DocumentDetailPanel({
+  clerkOrgId,
+  item,
+  onClose,
+}: DocumentDetailPanelProps) {
+  const updateDocumentArchiveItem = useMutation(
+    api.documentArchive.updateDocumentArchiveItem,
+  )
+
+  const [acting, setActing] = useState(false)
+  const [showRejectReason, setShowRejectReason] = useState(false)
+  const [rejectionReason, setRejectionReason] = useState(
+    item.rejectionReason ?? '',
+  )
+  const [toast, setToast] = useState<{
+    variant: 'success' | 'danger'
+    message: string
+  } | null>(null)
+
+  const isFinal =
+    item.status === 'verified' ||
+    item.status === 'rejected' ||
+    item.status === 'expired'
+
+  const handleVerify = useCallback(async () => {
+    if (!clerkOrgId || acting) return
+    setActing(true)
+    setToast(null)
+    try {
+      await updateDocumentArchiveItem({
+        clerkOrgId,
+        itemId: item._id,
+        status: 'verified',
+      })
+      setToast({ variant: 'success', message: 'Document verified' })
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err)
+      setToast({ variant: 'danger', message })
+    } finally {
+      setActing(false)
+    }
+  }, [clerkOrgId, acting, item._id, updateDocumentArchiveItem])
+
+  const handleReject = useCallback(async () => {
+    if (!clerkOrgId || acting) return
+    setActing(true)
+    setToast(null)
+    try {
+      await updateDocumentArchiveItem({
+        clerkOrgId,
+        itemId: item._id,
+        rejectionReason,
+        status: 'rejected',
+      })
+      setToast({ variant: 'success', message: 'Document rejected' })
+      setShowRejectReason(false)
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err)
+      setToast({ variant: 'danger', message })
+    } finally {
+      setActing(false)
+    }
+  }, [clerkOrgId, acting, item._id, rejectionReason, updateDocumentArchiveItem])
+
+  return (
+    <>
+      <div
+        aria-hidden='true'
+        className='fixed inset-0 z-40 bg-atria-ink/30'
+        onClick={onClose}
+      />
+      <div className='fixed inset-y-0 right-0 z-50 flex w-full max-w-md flex-col bg-atria-surface shadow-xl'>
+        <div className='flex items-center justify-between border-b border-atria-border p-5'>
+          <h2 className='text-xl font-bold text-atria-ink'>Document details</h2>
+          <Button
+            aria-label='Close panel'
+            onClick={onClose}
+            size='sm'
+            variant='ghost'
+          >
+            <X className='h-5 w-5' />
+          </Button>
+        </div>
+        <div className='flex-1 space-y-6 overflow-y-auto p-5'>
+          {toast && (
+            <Toast
+              onClose={() => setToast(null)}
+              title={toast.message}
+              variant={toast.variant}
+            />
+          )}
+          <DetailField label='File'>
+            {item.downloadUrl ? (
+              <a
+                className='text-base font-semibold text-atria-info hover:underline'
+                href={item.downloadUrl}
+                rel='noreferrer'
+                target='_blank'
+              >
+                {item.fileName}
+              </a>
+            ) : (
+              <p className='text-base font-semibold text-atria-ink'>
+                {item.fileName}
+              </p>
+            )}
+          </DetailField>
+          <DetailField label='Type'>
+            <p className='text-base text-atria-ink'>{item.documentType}</p>
+          </DetailField>
+          <DetailField label='Linked to'>
+            <p className='text-base text-atria-ink'>{item.linkedToName}</p>
+          </DetailField>
+          <DetailField label='Status'>
+            <StatusBadge variant={STATUS_CONFIG[item.status].variant}>
+              {STATUS_CONFIG[item.status].label}
+            </StatusBadge>
+          </DetailField>
+          <DetailField label='Expires'>
+            <p className='text-base text-atria-ink'>
+              {item.expiresAt
+                ? new Date(item.expiresAt).toLocaleDateString()
+                : '—'}
+            </p>
+          </DetailField>
+          {item.status === 'verified' && item.verifiedBy && (
+            <DetailField label='Verified by'>
+              <p className='text-base text-atria-ink'>
+                {item.verifiedBy}
+                {item.verifiedAt &&
+                  ` on ${new Date(item.verifiedAt).toLocaleDateString()}`}
+              </p>
+            </DetailField>
+          )}
+          {item.status === 'rejected' && item.rejectionReason && (
+            <DetailField label='Rejection reason'>
+              <p className='text-base text-atria-ink'>{item.rejectionReason}</p>
+            </DetailField>
+          )}
+          {!isFinal && (
+            <div className='space-y-3'>
+              {showRejectReason ? (
+                <>
+                  <FieldGroup
+                    htmlFor='detail-rejection-reason'
+                    label='Rejection reason'
+                    required
+                  >
+                    <Textarea
+                      id='detail-rejection-reason'
+                      onChange={(e) => setRejectionReason(e.target.value)}
+                      rows={4}
+                      value={rejectionReason}
+                    />
+                  </FieldGroup>
+                  <div className='flex gap-2'>
+                    <Button
+                      className='bg-atria-success hover:bg-atria-success/90'
+                      disabled={acting || !rejectionReason.trim()}
+                      onClick={handleReject}
+                      variant='primary'
+                    >
+                      {acting ? 'Rejecting…' : 'Confirm reject'}
+                    </Button>
+                    <Button
+                      onClick={() => setShowRejectReason(false)}
+                      variant='ghost'
+                    >
+                      Cancel
+                    </Button>
+                  </div>
+                </>
+              ) : (
+                <div className='flex gap-2'>
+                  <Button
+                    className='bg-atria-success hover:bg-atria-success/90'
+                    disabled={acting}
+                    onClick={handleVerify}
+                    variant='primary'
+                  >
+                    {acting ? 'Verifying…' : 'Verify'}
+                  </Button>
+                  <Button
+                    disabled={acting}
+                    onClick={() => setShowRejectReason(true)}
+                    variant='danger'
+                  >
+                    Reject
+                  </Button>
+                </div>
+              )}
+            </div>
+          )}
+        </div>
+      </div>
+    </>
+  )
+}
+
+function DetailField({
+  children,
+  label,
+}: {
+  children: React.ReactNode
+  label: string
+}) {
+  return (
+    <div className='space-y-1'>
+      <p className='text-[13px] font-semibold uppercase tracking-wide text-atria-text-muted'>
+        {label}
+      </p>
+      {children}
+    </div>
+  )
+}
diff --git a/src/features/documents/pages/DocumentArchiveRoute.tsx b/src/features/documents/pages/DocumentArchiveRoute.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/documents/pages/DocumentArchiveRoute.tsx
@@ -0,0 +1,12 @@
+import { Suspense, lazy } from 'react'
+import { AppLoader } from '@/shared/ui/AppLoader'
+
+const DocumentArchivePage = lazy(() => import('./DocumentArchivePage'))
+
+export function DocumentArchiveRoute() {
+  return (
+    <Suspense fallback={<AppLoader label='Loading archive' />}>
+      <DocumentArchivePage />
+    </Suspense>
+  )
+}
diff --git a/src/app/routing/RoleRouteGuard.tsx b/src/app/routing/RoleRouteGuard.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/app/routing/RoleRouteGuard.tsx
@@ -0,0 +1,42 @@
+import { Navigate } from 'react-router-dom'
+import { useOrganization, useUser } from '@clerk/react'
+import { useQuery } from 'convex/react'
+import { api } from '../../../convex/_generated/api'
+import { AppLoader } from '@/shared/ui/AppLoader'
+
+export type MemberRole =
+  | 'org:admin'
+  | 'org:hr'
+  | 'org:coordinator'
+  | 'org:caregiver'
+  | 'org:candidate'
+
+export function RoleRouteGuard({
+  allowed,
+  children,
+}: {
+  allowed: MemberRole[]
+  children: React.ReactNode
+}) {
+  const { organization, isLoaded: orgLoaded } = useOrganization()
+  const { user, isLoaded: userLoaded } = useUser()
+  const clerkOrgId = organization?.id
+  const member = useQuery(
+    api.members.me,
+    clerkOrgId ? { clerkOrgId } : 'skip',
+  )
+
+  if (!orgLoaded || !userLoaded || member === undefined) {
+    return <AppLoader label='Loading workspace' />
+  }
+
+  if (!organization || !user || member === null) {
+    return <Navigate replace to='/sign-in' />
+  }
+
+  if (!allowed.includes(member.role as MemberRole)) {
+    return <Navigate replace to='/' />
+  }
+
+  return <>{children}</>
+}
diff --git a/src/features/forms/components/DynamicFormRenderer.test.tsx b/src/features/forms/components/DynamicFormRenderer.test.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/components/DynamicFormRenderer.test.tsx
@@ -0,0 +1,86 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen, fireEvent, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { DynamicFormRenderer, FormField } from './DynamicFormRenderer'
+
+const formDefinition = {
+  id: 'form-1',
+  name: 'Test form',
+  fields: [
+    {
+      helperText: 'As on ID',
+      id: 'fullName',
+      label: 'Full name',
+      required: true,
+      type: 'text',
+    },
+    { id: 'bio', label: 'Bio', required: false, type: 'textarea' },
+    {
+      id: 'role',
+      label: 'Role',
+      options: [{ label: 'Caregiver', value: 'cg' }],
+      required: true,
+      type: 'select',
+    },
+    { id: 'agree', label: 'I agree', required: true, type: 'checkbox' },
+    { id: 'startDate', label: 'Start date', required: true, type: 'date' },
+    { id: 'years', label: 'Years', required: true, type: 'number' },
+  ] as FormField[],
+}
+
+describe('DynamicFormRenderer', () => {
+  const onSubmit = vi.fn()
+
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it('renders all field types', () => {
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    expect(screen.getByLabelText(/Full name/i)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Bio/i)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Role/i)).toBeInTheDocument()
+    expect(screen.getByLabelText(/I agree/i)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Start date/i)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Years/i)).toBeInTheDocument()
+  })
+
+  it('shows required indicators', () => {
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    expect(screen.getAllByText('*').length).toBeGreaterThan(0)
+  })
+
+  it('shows per-field errors when required fields are missing', async () => {
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    fireEvent.click(screen.getByRole('button', { name: /Submit/i }))
+    await waitFor(() => {
+      expect(screen.getAllByText(/This field is required/i).length).toBeGreaterThan(0)
+    })
+    expect(onSubmit).not.toHaveBeenCalled()
+  })
+
+  it('calls onSubmit with data when valid', async () => {
+    const user = userEvent.setup()
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    await user.type(screen.getByLabelText(/Full name/i), 'Jane Doe')
+    await user.selectOptions(screen.getByLabelText(/Role/i), 'cg')
+    await user.click(screen.getByLabelText(/I agree/i))
+    await user.type(screen.getByLabelText(/Start date/i), '2026-07-01')
+    await user.type(screen.getByLabelText(/Years/i), '3')
+    await user.click(screen.getByRole('button', { name: /Submit/i }))
+    await waitFor(() => {
+      expect(onSubmit).toHaveBeenCalledTimes(1)
+    })
+    const data = onSubmit.mock.calls[0][0]
+    expect(data.fullName).toBe('Jane Doe')
+    expect(data.role).toBe('cg')
+    expect(data.agree).toBe(true)
+    expect(data.startDate).toBe('2026-07-01')
+    expect(data.years).toBe(3)
+  })
+})
diff --git a/src/features/documents/pages/DocumentArchivePage.test.tsx b/src/features/documents/pages/DocumentArchivePage.test.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/documents/pages/DocumentArchivePage.test.tsx
@@ -0,0 +1,130 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { MemoryRouter } from 'react-router-dom'
+import { getFunctionName } from 'convex/server'
+import type { Id } from '../../../../convex/_generated/dataModel'
+
+const mocks = {
+  updateDocumentArchiveItem: vi.fn(),
+}
+
+vi.mock('@clerk/react', async () => {
+  const actual = await vi.importActual<typeof import('@clerk/react')>('@clerk/react')
+  return {
+    ...actual,
+    useOrganization: () => ({ organization: { id: 'org_123' }, isLoaded: true }),
+    useUser: () => ({ user: { id: 'user_1' }, isLoaded: true }),
+  }
+})
+
+vi.mock('convex/react', async () => {
+  const actual = await vi.importActual<typeof import('convex/react')>('convex/react')
+  return {
+    ...actual,
+    useMutation: vi.fn((mutationRef: unknown) => {
+      const name = getFunctionName(mutationRef as Parameters<typeof getFunctionName>[0])
+      if (name === 'documentArchive:updateDocumentArchiveItem') {
+        return mocks.updateDocumentArchiveItem
+      }
+      return vi.fn()
+    }),
+    useQuery: vi.fn(),
+  }
+})
+
+const { useQuery } = await import('convex/react')
+
+const items = [
+  {
+    _id: 'doc_1' as Id<'documentArchiveItems'>,
+    documentType: 'id',
+    expiresAt: '2026-12-31T00:00:00.000Z',
+    fileName: 'ID.pdf',
+    linkedToName: 'Lucía Fernández',
+    status: 'pending_review',
+  },
+  {
+    _id: 'doc_2' as Id<'documentArchiveItems'>,
+    documentType: 'certification',
+    fileName: 'CPR.pdf',
+    linkedToName: 'Pedro Ramírez',
+    status: 'verified',
+  },
+]
+
+function mockArchiveState() {
+  vi.mocked(useQuery).mockImplementation(
+    ((queryRef: unknown) => {
+      const name = getFunctionName(queryRef as Parameters<typeof getFunctionName>[0])
+      if (name === 'documentArchive:listDocumentArchive') return items
+      return undefined
+    }) as unknown as typeof useQuery,
+  )
+}
+
+describe('DocumentArchivePage', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it('renders filters and table', async () => {
+    const { DocumentArchivePage } = await import('./DocumentArchivePage')
+    mockArchiveState()
+    render(
+      <MemoryRouter>
+        <DocumentArchivePage />
+      </MemoryRouter>,
+    )
+    expect(screen.getByText('Document archive')).toBeInTheDocument()
+    expect(screen.getByRole('combobox', { name: /Document type/i })).toBeInTheDocument()
+    expect(screen.getByRole('combobox', { name: /Status/i })).toBeInTheDocument()
+    expect(screen.getByText('ID.pdf')).toBeInTheDocument()
+    expect(screen.getByText('CPR.pdf')).toBeInTheDocument()
+  })
+
+  it('calls updateDocumentArchiveItem with verified on Verify click', async () => {
+    const user = userEvent.setup()
+    const { DocumentArchivePage } = await import('./DocumentArchivePage')
+    mocks.updateDocumentArchiveItem.mockResolvedValueOnce({})
+    mockArchiveState()
+    render(
+      <MemoryRouter>
+        <DocumentArchivePage />
+      </MemoryRouter>,
+    )
+    const verifyButtons = screen.getAllByRole('button', { name: /Verify/i })
+    await user.click(verifyButtons[0])
+    await waitFor(() => {
+      expect(mocks.updateDocumentArchiveItem).toHaveBeenCalledWith(
+        expect.objectContaining({
+          clerkOrgId: 'org_123',
+          itemId: 'doc_1',
+          status: 'verified',
+        }),
+      )
+    })
+  })
+
+  it('opens reject modal and calls update with rejected', async () => {
+    const user = userEvent.setup()
+    const { DocumentArchivePage } = await import('./DocumentArchivePage')
+    mocks.updateDocumentArchiveItem.mockResolvedValueOnce({})
+    mockArchiveState()
+    render(
+      <MemoryRouter>
+        <DocumentArchivePage />
+      </MemoryRouter>,
+    )
+    const rejectButtons = screen.getAllByRole('button', { name: /Reject/i })
+    await user.click(rejectButtons[0])
+    const textarea = await screen.findByLabelText(/Rejection reason/i)
+    await user.type(textarea, 'Expired document')
+    await user.click(screen.getByRole('button', { name: /^Reject$/i }))
+    await waitFor(() => {
+      expect(mocks.updateDocumentArchiveItem).toHaveBeenCalledWith(
+        expect.objectContaining({
+          clerkOrgId: 'org_123',
+          itemId: 'doc_1',
+          rejectionReason: 'Expired document',
+          status: 'rejected',
+        }),
+      )
+    })
+  })
+})
diff --git a/src/features/forms/pages/FormSubmissionPage.test.tsx b/src/features/forms/pages/FormSubmissionPage.test.tsx
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/src/features/forms/pages/FormSubmissionPage.test.tsx
@@ -0,0 +1,86 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { MemoryRouter } from 'react-router-dom'
+import { getFunctionName } from 'convex/server'
+
+const navigateMock = vi.fn()
+
+vi.mock('react-router-dom', async () => {
+  const actual = await vi.importActual<typeof import('react-router-dom')>('react-router-dom')
+  return {
+    ...actual,
+    useNavigate: () => navigateMock,
+    useParams: () => ({ formDefinitionId: 'form-1' }),
+  }
+})
+
+const mocks = {
+  submitForm: vi.fn(),
+}
+
+vi.mock('@clerk/react', async () => {
+  const actual = await vi.importActual<typeof import('@clerk/react')>('@clerk/react')
+  return {
+    ...actual,
+    useOrganization: () => ({ organization: { id: 'org_123' }, isLoaded: true }),
+    useUser: () => ({ user: { id: 'user_1' }, isLoaded: true }),
+  }
+})
+
+vi.mock('convex/react', async () => {
+  const actual = await vi.importActual<typeof import('convex/react')>('convex/react')
+  return {
+    ...actual,
+    useMutation: vi.fn((mutationRef: unknown) => {
+      const name = getFunctionName(mutationRef as Parameters<typeof getFunctionName>[0])
+      if (name === 'forms:submitForm') return mocks.submitForm
+      return vi.fn()
+    }),
+    useQuery: vi.fn(),
+  }
+})
+
+const { useQuery } = await import('convex/react')
+
+const formDefinition = {
+  _id: 'form-1',
+  fields: [{ id: 'signature', label: 'Signature', required: true, type: 'text' }],
+  name: 'HIPAA Acknowledgment',
+}
+
+function mockFormState(role = 'org:candidate') {
+  vi.mocked(useQuery).mockImplementation(
+    ((queryRef: unknown) => {
+      const name = getFunctionName(queryRef as Parameters<typeof getFunctionName>[0])
+      if (name === 'forms:listFormDefinitions') return [formDefinition]
+      if (name === 'members:me') return { role }
+      return undefined
+    }) as unknown as typeof useQuery,
+  )
+}
+
+describe('FormSubmissionPage', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it('fetches form definition and submits form', async () => {
+    const user = userEvent.setup()
+    const { FormSubmissionPage } = await import('./FormSubmissionPage')
+    mocks.submitForm.mockResolvedValueOnce({})
+    mockFormState('org:candidate')
+    render(
+      <MemoryRouter>
+        <FormSubmissionPage />
+      </MemoryRouter>,
+    )
+    await user.type(screen.getByLabelText(/Signature/i), 'Jane Doe')
+    await user.click(screen.getByRole('button', { name: /Submit/i }))
+    await waitFor(() => {
+      expect(mocks.submitForm).toHaveBeenCalledTimes(1)
+    })
+    expect(mocks.submitForm).toHaveBeenCalledWith(
+      expect.objectContaining({
+        clerkOrgId: 'org_123',
+        data: expect.objectContaining({ signature: 'Jane Doe' }),
+        formDefinitionId: 'form-1',
