+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { FormSubmissionPage } from './FormSubmissionPage'
+
+const navigateMock = vi.fn()
+const submitMock = vi.fn()
+
+vi.mock('@clerk/clerk-react', () => ({
+  useOrganization: () => ({ membership: { role: 'org:candidate' }, isLoaded: true }),
+}))
+
+vi.mock('react-router-dom', () => ({
+  useParams: () => ({ formDefinitionId: 'f1' }),
+  useNavigate: () => navigateMock,
+}))
+
+vi.mock('convex/react', () => ({
+  useQuery: vi.fn(),
+  useMutation: vi.fn(),
+}))
+
+vi.mock('sonner', () => ({
+  toast: { success: vi.fn(), error: vi.fn() },
+}))
+
+const mockDefinition = {
+  id: 'f1',
+  name: 'Onboarding',
+  fields: [{ id: 'name', type: 'text', label: 'Name', required: true }],
+}
+
+import { useQuery, useMutation } from 'convex/react'
+
+describe('FormSubmissionPage', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    useQuery.mockReturnValue([mockDefinition])
+    useMutation.mockReturnValue(submitMock)
+  })
+
+  it('fetches form definition and calls submitForm', async () => {
+    render(<FormSubmissionPage />)
+    expect(screen.getByText('Onboarding')).toBeInTheDocument()
+    await userEvent.type(screen.getByLabelText(/Name/i), 'Alex')
+    await userEvent.click(screen.getByRole('button', { name: /Submit/i }))
+    expect(submitMock).toHaveBeenCalledWith({
+      formDefinitionId: 'f1',
+      data: { name: 'Alex' },
+    })
+    expect(navigateMock).toHaveBeenCalledWith('/onboarding')
+  })
+})

Self-review note:
