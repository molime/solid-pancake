diff --git a/src/features/forms/components/DynamicFormRenderer.test.tsx b/src/features/forms/components/DynamicFormRenderer.test.tsx
new file mode 100644
--- /dev/null
+++ b/src/features/forms/components/DynamicFormRenderer.test.tsx
@@ -0,0 +1,66 @@
+import { describe, it, expect, vi } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { DynamicFormRenderer } from './DynamicFormRenderer'
+
+const formDefinition = {
+  id: 'form-1',
+  name: 'Worker onboarding',
+  fields: [
+    { id: 'fullName', type: 'text' as const, label: 'Full name', required: true },
+    { id: 'bio', type: 'textarea' as const, label: 'Bio', helperText: 'Tell us about yourself' },
+    {
+      id: 'role',
+      type: 'select' as const,
+      label: 'Role',
+      required: true,
+      options: [{ label: 'Caregiver', value: 'caregiver' }],
+    },
+    { id: 'agree', type: 'checkbox' as const, label: 'Agree', required: true, helperText: 'I agree' },
+    { id: 'startDate', type: 'date' as const, label: 'Start date', required: true },
+    { id: 'years', type: 'number' as const, label: 'Years', required: true },
+  ],
+}
+
+describe('DynamicFormRenderer', () => {
+  it('renders all field types', () => {
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={vi.fn()} />)
+    expect(screen.getByLabelText(/Full name/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Bio/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Role/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Agree/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Start date/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Years/)).toBeInTheDocument()
+  })
+
+  it('shows red asterisk on required fields', () => {
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={vi.fn()} />)
+    expect(screen.getAllByText('*').length).toBeGreaterThan(0)
+  })
+
+  it('blocks submit and shows per-field errors when required fields are empty', async () => {
+    const onSubmit = vi.fn()
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    await userEvent.click(screen.getByRole('button', { name: /Submit/i }))
+    expect(await screen.findAllByText(/is required/)).toHaveLength(5)
+    expect(onSubmit).not.toHaveBeenCalled()
+  })
+
+  it('calls onSubmit with data when valid', async () => {
+    const onSubmit = vi.fn()
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    await userEvent.type(screen.getByLabelText(/Full name/i), 'Jane Doe')
+    await userEvent.type(screen.getByLabelText(/Bio/i), 'Hello')
+    await userEvent.selectOptions(screen.getByLabelText(/Role/i), 'caregiver')
+    await userEvent.click(screen.getByLabelText(/Agree/i))
+    await userEvent.type(screen.getByLabelText(/Start date/i), '2025-01-01')
+    await userEvent.type(screen.getByLabelText(/Years/i), '2')
+    await userEvent.click(screen.getByRole('button', { name: /Submit/i }))
+    expect(onSubmit).toHaveBeenCalledWith(expect.objectContaining({
+      fullName: 'Jane Doe',
+      bio: 'Hello',
+      role: 'caregiver',
+      agree: true,
+      startDate: '2025-01-01',
+      years: 2,
+    }))
+  })
+})
diff --git a/src/features/documents/pages/DocumentArchivePage.test.tsx b/src/features/documents/pages/DocumentArchivePage.test.tsx
new file mode 100644
--- /dev/null
+++ b/src/features/documents/pages/DocumentArchivePage.test.tsx
@@ -0,0 +1,62 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { DocumentArchivePage } from './DocumentArchivePage'
+
+vi.mock('@clerk/clerk-react', () => ({
+  useOrganization: () => ({ membership: { role: 'org:admin' }, isLoaded: true }),
+}))
+
+vi.mock('convex/react', () => ({
+  useQuery: vi.fn(),
+  useMutation: vi.fn(),
+}))
+
+vi.mock('sonner', () => ({
+  toast: { success: vi.fn(), error: vi.fn() },
+}))
+
+const mockItem = {
+  _id: 'd1',
+  fileName: 'License.pdf',
+  documentType: 'certification',
+  status: 'pending_review',
+  linkedEntityName: 'Jane Doe',
+}
+
+const updateMock = vi.fn()
+
+import { useQuery, useMutation } from 'convex/react'
+
+describe('DocumentArchivePage', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    useQuery.mockReturnValue([mockItem])
+    useMutation.mockReturnValue(updateMock)
+  })
+
+  it('renders with filters and table', () => {
+    render(<DocumentArchivePage />)
+    expect(screen.getByText('Document archive')).toBeInTheDocument()
+    expect(screen.getByText('License.pdf')).toBeInTheDocument()
+  })
+
+  it('Verify calls updateDocumentArchiveItem with status verified', async () => {
+    render(<DocumentArchivePage />)
+    await userEvent.click(screen.getByRole('button', { name: 'Verify' }))
+    expect(updateMock).toHaveBeenCalledWith({ id: 'd1', status: 'verified' })
+  })
+
+  it('Reject opens reason modal and calls update with status rejected', async () => {
+    render(<DocumentArchivePage />)
+    await userEvent.click(screen.getByRole('button', { name: 'Reject' }))
+    expect(screen.getByText('Reject document')).toBeInTheDocument()
+    const reasonInput = screen.getByPlaceholderText('Enter rejection reason...')
+    await userEvent.type(reasonInput, 'Missing signature')
+    await userEvent.click(screen.getByRole('button', { name: 'Reject', exact: false }))
+    expect(updateMock).toHaveBeenCalledWith({
+      id: 'd1',
+      status: 'rejected',
+      rejectionReason: 'Missing signature',
+    })
+  })
+})
