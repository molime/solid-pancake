+import { render, screen, fireEvent, waitFor } from '@testing-library/react'
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { useQuery, useMutation } from 'convex/react'
+import DocumentArchivePage from './DocumentArchivePage'
+
+vi.mock('convex/react', () => ({
+  useQuery: vi.fn(),
+  useMutation: vi.fn(),
+}))
+
+vi.mock('sonner', () => ({
+  toast: { success: vi.fn(), error: vi.fn() },
+}))
+
+const mockedUseQuery = vi.mocked(useQuery)
+const mockedUseMutation = vi.mocked(useMutation)
+
+const mockItem = {
+  _id: 'doc1',
+  name: 'Passport.pdf',
+  type: 'id',
+  linkedEntityName: 'Ada Lovelace',
+  status: 'pending_review',
+  expiryDate: Date.now() + 100000000,
+}
+
+describe('DocumentArchivePage', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it('renders with filters and document list', () => {
+    mockedUseQuery.mockReturnValue([mockItem] as any)
+    mockedUseMutation.mockReturnValue(vi.fn())
+    render(<DocumentArchivePage />)
+    expect(screen.getByText('Document archive')).toBeInTheDocument()
+    expect(screen.getByText('Passport.pdf')).toBeInTheDocument()
+    expect(screen.getByText('Pending')).toBeInTheDocument()
+  })
+
+  it('calls updateDocumentArchiveItem with verified status on Verify', async () => {
+    const mutate = vi.fn().mockResolvedValue(undefined)
+    mockedUseQuery.mockReturnValue([mockItem] as any)
+    mockedUseMutation.mockReturnValue(mutate)
+    render(<DocumentArchivePage />)
+    fireEvent.click(screen.getByRole('button', { name: 'Verify' }))
+    await waitFor(() =>
+      expect(mutate).toHaveBeenCalledWith({ id: 'doc1', status: 'verified' }),
+    )
+  })
+
+  it('opens reject modal and calls updateDocumentArchiveItem with rejected status and reason', async () => {
+    const mutate = vi.fn().mockResolvedValue(undefined)
+    mockedUseQuery.mockReturnValue([mockItem] as any)
+    mockedUseMutation.mockReturnValue(mutate)
+    render(<DocumentArchivePage />)
+    fireEvent.click(screen.getByRole('button', { name: 'Reject' }))
+    fireEvent.change(screen.getByLabelText(/Rejection reason/), {
+      target: { value: 'Blurry scan' },
+    })
+    const rejectButtons = screen.getAllByRole('button', { name: /^Reject$/ })
+    fireEvent.click(rejectButtons[rejectButtons.length - 1])
+    await waitFor(() =>
+      expect(mutate).toHaveBeenCalledWith({
+        id: 'doc1',
+        status: 'rejected',
+        rejectionReason: 'Blurry scan',
+      }),
+    )
+  })
+})
