+++ b/src/features/documents/pages/DocumentArchivePage.tsx
@@ -0,0 +1,250 @@
+import { useMemo, useState } from 'react'
+import { useQuery, useMutation } from 'convex/react'
+import { toast } from 'sonner'
+import { Id } from 'convex/values'
+import { api } from '../../../../convex/_generated/api'
+import { Button } from '@/shared/ui/Button'
+import { Input } from '@/shared/ui/Input'
+import { Select } from '@/shared/ui/Select'
+import { Checkbox } from '@/shared/ui/Checkbox'
+import { Textarea } from '@/shared/ui/Textarea'
+import { DocumentDetailPanel } from '../components/DocumentDetailPanel'
+
+type DocumentStatus = 'pending_review' | 'verified' | 'rejected' | 'expired'
+type DocumentType = 'id' | 'certification' | 'signed_form' | 'other'
+
+const statusLabels: Record<DocumentStatus, string> = {
+  pending_review: 'Pending',
+  verified: 'Verified',
+  rejected: 'Rejected',
+  expired: 'Expired',
+}
+
+const statusOptions = [
+  { value: 'all', label: 'All' },
+  { value: 'pending_review', label: 'Pending' },
+  { value: 'verified', label: 'Verified' },
+  { value: 'rejected', label: 'Rejected' },
+  { value: 'expired', label: 'Expired' },
+]
+
+const typeOptions = [
+  { value: 'all', label: 'All' },
+  { value: 'id', label: 'ID' },
+  { value: 'certification', label: 'Certification' },
+  { value: 'signed_form', label: 'Signed form' },
+  { value: 'other', label: 'Other' },
+]
+
+function StatusBadge({ status }: { status: DocumentStatus }) {
+  const color =
+    status === 'verified'
+      ? 'bg-green-100 text-green-800'
+      : status === 'pending_review'
+        ? 'bg-gray-100 text-gray-800'
+        : 'bg-red-100 text-red-800'
+  return (
+    <span className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${color}`}>
+      {statusLabels[status]}
+    </span>
+  )
+}
+
+export default function DocumentArchivePage() {
+  const [typeFilter, setTypeFilter] = useState<string>('all')
+  const [statusFilter, setStatusFilter] = useState<string>('all')
+  const [expiringSoon, setExpiringSoon] = useState(false)
+  const [search, setSearch] = useState('')
+  const [selectedId, setSelectedId] = useState<string | null>(null)
+  const [rejectingId, setRejectingId] = useState<string | null>(null)
+  const [rejectReason, setRejectReason] = useState('')
+
+  const queryArgs = useMemo(
+    () => ({
+      type: typeFilter === 'all' ? undefined : (typeFilter as DocumentType),
+      status: statusFilter === 'all' ? undefined : (statusFilter as DocumentStatus),
+      expiringSoon: expiringSoon || undefined,
+      search: search.trim() || undefined,
+    }),
+    [typeFilter, statusFilter, expiringSoon, search],
+  )
+
+  const items = useQuery(api.documents.listDocumentArchive, queryArgs)
+
+  const updateDocument = useMutation(api.documents.updateDocumentArchiveItem, {
+    optimisticUpdate: (ctx, { id, status, rejectionReason }) => {
+      ctx.setQuery(api.documents.listDocumentArchive, queryArgs, (prev: any[] | undefined) => {
+        if (!prev) return prev
+        return prev.map((item: any) =>
+          item._id === id ? { ...item, status, rejectionReason } : item,
+        )
+      })
+    },
+  })
+
+  const handleVerify = async (id: string) => {
+    await updateDocument({ id: id as Id<'documents'>, status: 'verified' })
+    toast.success('Document verified')
+  }
+
+  const startReject = (id: string) => {
+    setRejectingId(id)
+    setRejectReason('')
+  }
+
+  const confirmReject = async () => {
+    if (!rejectingId) return
+    await updateDocument({
+      id: rejectingId as Id<'documents'>,
+      status: 'rejected',
+      rejectionReason: rejectReason.trim() || undefined,
+    })
+    toast.success('Document rejected')
+    setRejectingId(null)
+    setRejectReason('')
+  }
+
+  const selectedItem = items?.find((item) => item._id === selectedId) ?? null
+
+  return (
+    <div className="p-8">
+      <h1 className="mb-6 text-2xl font-semibold">Document archive</h1>
+
+      <div className="mb-6 flex flex-wrap items-end gap-4">
+        <div>
+          <label className="mb-1 block text-xs font-medium uppercase text-gray-600">
+            Document type
+          </label>
+          <Select options={typeOptions} value={typeFilter} onChange={setTypeFilter} />
+        </div>
+        <div>
+          <label className="mb-1 block text-xs font-medium uppercase text-gray-600">
+            Status
+          </label>
+          <Select options={statusOptions} value={statusFilter} onChange={setStatusFilter} />
+        </div>
+        <label className="flex items-center gap-2 pb-2">
+          <Checkbox checked={expiringSoon} onChange={setExpiringSoon} />
+          <span className="text-sm">Expiring soon</span>
+        </label>
+        <Input
+          placeholder="Search by name"
+          value={search}
+          onChange={(e) => setSearch(e.target.value)}
+        />
+      </div>
+
+      {items && items.length === 0 ? (
+        <div className="rounded-lg border border-dashed p-12 text-center text-gray-500">
+          No documents match your filters.
+        </div>
+      ) : (
+        <div className="overflow-x-auto rounded-lg border">
+          <table className="w-full text-left text-sm">
+            <thead className="bg-gray-50 text-xs uppercase text-gray-600">
+              <tr>
+                <th className="px-4 py-3">Document</th>
+                <th className="px-4 py-3">Type</th>
+                <th className="px-4 py-3">Linked to</th>
+                <th className="px-4 py-3">Status</th>
+                <th className="px-4 py-3">Expires</th>
+                <th className="px-4 py-3">Actions</th>
+              </tr>
+            </thead>
+            <tbody className="divide-y">
+              {items?.map((item) => (
+                <tr key={item._id} className="hover:bg-gray-50">
+                  <td className="px-4 py-3">
+                    <button
+                      onClick={() => setSelectedId(item._id)}
+                      className="font-medium text-blue-600 hover:underline"
+                    >
+                      {item.name}
+                    </button>
+                  </td>
+                  <td className="px-4 py-3 capitalize">{item.type.replace(/_/g, ' ')}</td>
+                  <td className="px-4 py-3">{item.linkedEntityName}</td>
+                  <td className="px-4 py-3">
+                    <StatusBadge status={item.status as DocumentStatus} />
+                  </td>
+                  <td className="px-4 py-3">
+                    {item.expiryDate
+                      ? new Date(item.expiryDate).toLocaleDateString()
+                      : '-'}
+                  </td>
+                  <td className="px-4 py-3">
+                    <div className="flex gap-2">
+                      {item.status !== 'verified' && (
+                        <Button size="sm" onClick={() => handleVerify(item._id)}>
+                          Verify
+                        </Button>
+                      )}
+                      {item.status !== 'rejected' && item.status !== 'expired' && (
+                        <Button size="sm" variant="danger" onClick={() => startReject(item._id)}>
+                          Reject
+                        </Button>
+                      )}
+                    </div>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      )}
+
+      {rejectingId && (
+        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4">
+          <div className="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
+            <h2 className="mb-4 text-lg font-semibold">Reject document</h2>
+            <label className="mb-1 block text-sm font-medium">
+              Rejection reason
+              <Textarea
+                value={rejectReason}
+                onChange={(e) => setRejectReason(e.target.value)}
+                placeholder="Enter reason..."
+              />
+            </label>
+            <div className="mt-4 flex justify-end gap-2">
+              <Button variant="ghost" onClick={() => setRejectingId(null)}>
+                Cancel
+              </Button>
+              <Button
+                variant="danger"
+                onClick={confirmReject}
+                disabled={!rejectReason.trim()}
+              >
+                Reject
+              </Button>
+            </div>
+          </div>
+        </div>
+      )}
+
+      <DocumentDetailPanel
+        document={selectedItem}
+        isOpen={!!selectedId}
+        onClose={() => setSelectedId(null)}
+        onVerify={handleVerify}
+        onRejectStart={startReject}
+      />
+    </div>
+  )
+}
