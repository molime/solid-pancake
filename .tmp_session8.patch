+++ b/src/features/forms/components/DynamicFormRenderer.tsx
@@ -0,0 +1,149 @@
+import { useState, useCallback } from 'react'
+import { Button } from '@/shared/ui/Button'
+import { Input } from '@/shared/ui/Input'
+import { Textarea } from '@/shared/ui/Textarea'
+import { Select } from '@/shared/ui/Select'
+import { Checkbox } from '@/shared/ui/Checkbox'
+import { FieldGroup } from '@/shared/ui/FieldGroup'
+
+export type FormFieldOption = {
+  value: string
+  label: string
+}
+
+export type FormField = {
+  id: string
+  label: string
+  type: 'text' | 'textarea' | 'select' | 'checkbox' | 'date' | 'number'
+  required?: boolean
+  helperText?: string
+  options?: FormFieldOption[]
+  placeholder?: string
+}
+
+export type FormDefinition = {
+  id: string
+  name: string
+  fields: FormField[]
+}
+
+type DynamicFormRendererProps = {
+  formDefinition: FormDefinition
+  onSubmit: (data: Record<string, unknown>) => void
+  loading?: boolean
+  existingData?: Record<string, unknown>
+}
+
+function getInitialValue(
+  field: FormField,
+  existingData?: Record<string, unknown>,
+): unknown {
+  if (existingData && field.id in existingData) {
+    return existingData[field.id]
+  }
+  return field.type === 'checkbox' ? false : ''
+}
+
+export function DynamicFormRenderer({
+  formDefinition,
+  onSubmit,
+  loading,
+  existingData,
+}: DynamicFormRendererProps) {
+  const [data, setData] = useState<Record<string, unknown>>(() => {
+    const initial: Record<string, unknown> = {}
+    for (const field of formDefinition.fields) {
+      initial[field.id] = getInitialValue(field, existingData)
+    }
+    return initial
+  })
+
+  const [errors, setErrors] = useState<Record<string, string>>({})
+
+  const updateField = useCallback((id: string, value: unknown) => {
+    setData((prev) => ({ ...prev, [id]: value }))
+    setErrors((prev) => {
+      if (!prev[id]) return prev
+      const next = { ...prev }
+      delete next[id]
+      return next
+    })
+  }, [])
+
+  const validate = useCallback((): boolean => {
+    const next: Record<string, string> = {}
+    for (const field of formDefinition.fields) {
+      if (!field.required) continue
+      const value = data[field.id]
+      let missing = false
+      if (field.type === 'checkbox') {
+        missing = value !== true
+      } else if (typeof value === 'string') {
+        missing = value.trim() === ''
+      } else {
+        missing = value === undefined || value === null || value === ''
+      }
+      if (missing) {
+        next[field.id] = 'This field is required'
+      }
+    }
+    setErrors(next)
+    return Object.keys(next).length === 0
+  }, [data, formDefinition.fields])
+
+  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault()
+    if (!validate()) return
+    onSubmit(data)
+  }
+
+  return (
+    <form onSubmit={handleSubmit} className="space-y-6">
+      <h1 className="text-2xl font-semibold text-gray-900">{formDefinition.name}</h1>
+      {formDefinition.fields.map((field) => (
+        <FieldGroup
+          key={field.id}
+          label={field.label}
+          helperText={field.helperText}
+          error={errors[field.id]}
+          required={field.required}
+        >
+          {field.type === 'text' && (
+            <Input
+              name={field.id}
+              value={(data[field.id] as string) ?? ''}
+              onChange={(e) => updateField(field.id, e.target.value)}
+              placeholder={field.placeholder}
+            />
+          )}
+          {field.type === 'textarea' && (
+            <Textarea
+              name={field.id}
+              value={(data[field.id] as string) ?? ''}
+              onChange={(e) => updateField(field.id, e.target.value)}
+              placeholder={field.placeholder}
+            />
+          )}
+          {field.type === 'select' && (
+            <Select
+              name={field.id}
+              options={field.options ?? []}
+              value={(data[field.id] as string) ?? ''}
+              onChange={(value) => updateField(field.id, value)}
+            />
+          )}
+          {field.type === 'checkbox' && (
+            <Checkbox
+              name={field.id}
+              checked={!!data[field.id]}
+              onChange={(checked) => updateField(field.id, checked)}
+            />
+          )}
+          {field.type === 'date' && (
+            <Input
+              type="date"
+              name={field.id}
+              value={(data[field.id] as string) ?? ''}
+              onChange={(e) => updateField(field.id, e.target.value)}
+            />
+          )}
+          {field.type === 'number' && (
+            <Input
+              type="number"
+              name={field.id}
+              value={(data[field.id] as string) ?? ''}
+              onChange={(e) => updateField(field.id, e.target.value)}
+            />
+          )}
+        </FieldGroup>
+      ))}
+      <Button type="submit" disabled={loading}>
+        {loading ? 'Submitting...' : 'Submit'}
+      </Button>
+    </form>
+  )
+}
