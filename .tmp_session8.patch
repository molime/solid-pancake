@@ -0,0 +1,74 @@
+import { render, screen, fireEvent } from '@testing-library/react'
+import { describe, it, expect, vi } from 'vitest'
+import { DynamicFormRenderer } from './DynamicFormRenderer'
+
+const formDefinition = {
+  id: 'fd-1',
+  name: 'Worker intake',
+  fields: [
+    { id: 'fullName', label: 'Full name', type: 'text' as const, required: true, helperText: 'Legal name' },
+    { id: 'bio', label: 'Bio', type: 'textarea' as const },
+    {
+      id: 'role',
+      label: 'Role',
+      type: 'select' as const,
+      required: true,
+      options: [
+        { value: 'cna', label: 'CNA' },
+        { value: 'rn', label: 'RN' },
+      ],
+    },
+    { id: 'agree', label: 'I agree', type: 'checkbox' as const, required: true },
+    { id: 'startDate', label: 'Start date', type: 'date' as const, required: true },
+    { id: 'years', label: 'Years', type: 'number' as const },
+  ],
+}
+
+describe('DynamicFormRenderer', () => {
+  it('renders all field types', () => {
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={vi.fn()} />)
+    expect(screen.getByLabelText(/Full name/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Bio/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Role/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/I agree/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Start date/)).toBeInTheDocument()
+    expect(screen.getByLabelText(/Years/)).toBeInTheDocument()
+  })
+
+  it('shows a red asterisk on required fields', () => {
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={vi.fn()} />)
+    const nameLabel = screen.getByText(/Full name/)
+    expect(nameLabel.querySelector('span')).toHaveClass('text-red-500')
+  })
+
+  it('blocks submit and shows inline errors when required fields are empty', () => {
+    const onSubmit = vi.fn()
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    fireEvent.click(screen.getByRole('button', { name: /Submit/ }))
+    expect(onSubmit).not.toHaveBeenCalled()
+    expect(screen.getAllByText('This field is required').length).toBeGreaterThan(0)
+  })
+
+  it('calls onSubmit with data when valid', () => {
+    const onSubmit = vi.fn()
+    render(<DynamicFormRenderer formDefinition={formDefinition} onSubmit={onSubmit} />)
+    fireEvent.change(screen.getByLabelText(/Full name/), { target: { value: 'Ada' } })
+    fireEvent.change(screen.getByLabelText(/Role/), { target: { value: 'cna' } })
+    fireEvent.click(screen.getByLabelText(/I agree/))
+    fireEvent.change(screen.getByLabelText(/Start date/), { target: { value: '2025-01-01' } })
+    fireEvent.click(screen.getByRole('button', { name: /Submit/ }))
+    expect(onSubmit).toHaveBeenCalledWith(
+      expect.objectContaining({
+        fullName: 'Ada',
+        role: 'cna',
+        agree: true,
+        startDate: '2025-01-01',
+      }),
+    )
+  })
+})
