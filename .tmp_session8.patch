+import { Button } from '@/shared/ui/Button'
+
+type DocumentStatus = 'pending_review' | 'verified' | 'rejected' | 'expired'
+
+const statusLabels: Record<DocumentStatus, string> = {
+  pending_review: 'Pending',
+  verified: 'Verified',
+  rejected: 'Rejected',
+  expired: 'Expired',
+}
+
+function StatusBadge({ status }: { status: DocumentStatus }) {
+  const color =
+    status === 'verified'
+      ? 'bg-green-100 text-green-800'
+      : status === 'pending_review'
+        ? 'bg-gray-100 text-gray-800'
+        : 'bg-red-100 text-red-800'
+  return (
+    <span className={`inline-flex rounded-full px-2.5 py-0.5 text-xs font-medium ${color}`}>
+      {statusLabels[status]}
+    </span>
+  )
+}
+
+type DocumentArchiveItem = {
+  _id: string
+  name: string
+  type: string
+  linkedEntityName?: string
+  status: DocumentStatus
+  expiryDate?: number
+  url?: string
+  verifiedBy?: string
+  verifiedAt?: number
+  rejectionReason?: string
+}
+
+type DocumentDetailPanelProps = {
+  document: DocumentArchiveItem | null
+  isOpen: boolean
+  onClose: () => void
+  onVerify: (id: string) => void
+  onRejectStart: (id: string) => void
+}
+
+export function DocumentDetailPanel({
+  document,
+  isOpen,
+  onClose,
+  onVerify,
+  onRejectStart,
+}: DocumentDetailPanelProps) {
+  if (!document) return null
+
+  const isFinal =
+    document.status === 'verified' ||
+    document.status === 'rejected' ||
+    document.status === 'expired'
+
+  return (
+    <>
+      <div
+        className={`fixed inset-y-0 right-0 z-50 w-[480px] transform bg-white shadow-2xl transition-transform duration-300 ${isOpen ? 'translate-x-0' : 'translate-x-full'}`}
+      >
+        <div className="flex h-full flex-col p-6">
+          <div className="mb-6 flex items-start justify-between">
+            <h2 className="text-xl font-semibold">Document details</h2>
+            <Button variant="ghost" size="sm" onClick={onClose}>
+              Close
+            </Button>
+          </div>
+
+          <div className="space-y-4">
+            <div>
+              <p className="text-xs uppercase text-gray-500">File</p>
+              {document.url ? (
+                <a
+                  href={document.url}
+                  target="_blank"
+                  rel="noreferrer"
+                  className="text-blue-600 hover:underline"
+                >
+                  {document.name}
+                </a>
+              ) : (
+                <p className="font-medium">{document.name}</p>
+              )}
+            </div>
+
+            <div>
+              <p className="text-xs uppercase text-gray-500">Type</p>
+              <p className="font-medium capitalize">{document.type.replace(/_/g, ' ')}</p>
+            </div>
+
+            <div>
+              <p className="text-xs uppercase text-gray-500">Linked to</p>
+              <p className="font-medium">{document.linkedEntityName ?? '-'}</p>
+            </div>
+
+            <div>
+              <p className="text-xs uppercase text-gray-500">Status</p>
+              <StatusBadge status={document.status} />
+            </div>
+
+            <div>
+              <p className="text-xs uppercase text-gray-500">Expires</p>
+              <p className="font-medium">
+                {document.expiryDate
+                  ? new Date(document.expiryDate).toLocaleDateString()
+                  : '-'}
+              </p>
+            </div>
+
+            {document.status === 'verified' && (
+              <div>
+                <p className="text-xs uppercase text-gray-500">Verified</p>
+                <p className="font-medium">
+                  {document.verifiedBy ? `${document.verifiedBy} ` : ''}
+                  {document.verifiedAt
+                    ? `on ${new Date(document.verifiedAt).toLocaleString()}`
+                    : ''}
+                </p>
+              </div>
+            )}
+
+            {document.status === 'rejected' && document.rejectionReason && (
+              <div>
+                <p className="text-xs uppercase text-gray-500">Rejection reason</p>
+                <p className="font-medium">{document.rejectionReason}</p>
+              </div>
+            )}
+          </div>
+
+          {!isFinal && (
+            <div className="mt-auto flex gap-3 pt-6">
+              <Button onClick={() => onVerify(document._id)}>Verify</Button>
+              <Button variant="danger" onClick={() => onRejectStart(document._id)}>
+                Reject
+              </Button>
+            </div>
+          )}
+        </div>
+      </div>
+
+      {isOpen && (
+        <div
+          className="fixed inset-0 z-40 bg-black/20"
+          onClick={onClose}
+        />
+      )}
+    </>
+  )
+}
