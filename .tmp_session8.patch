@@ -0,0 +1,26 @@
+import { Suspense, lazy } from 'react'
+import { useAuth } from '@clerk/clerk-react'
+import { Navigate } from 'react-router'
+
+const DocumentArchivePage = lazy(() => import('./DocumentArchivePage'))
+
+const allowedRoles = new Set(['org:admin', 'org:hr'])
+
+export default function DocumentArchiveRoute() {
+  const { orgRole, isLoaded } = useAuth()
+
+  if (!isLoaded) {
+    return <div className="p-8">Loading...</div>
+  }
+
+  if (!allowedRoles.has(orgRole ?? '')) {
+    return <Navigate to="/" replace />
+  }
+
+  return (
+    <Suspense fallback={<div className="p-8">Loading...</div>}>
+      <DocumentArchivePage />
+    </Suspense>
+  )
+}
