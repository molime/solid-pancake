+import { useState } from 'react'
+import { useParams, useNavigate } from 'react-router'
+import { useAuth } from '@clerk/clerk-react'
+import { useQuery, useMutation } from 'convex/react'
+import { toast } from 'sonner'
+import { Id } from 'convex/values'
+import { api } from '../../../../convex/_generated/api'
+import { DynamicFormRenderer } from '../../components/DynamicFormRenderer'
+import type { FormDefinition } from '../../components/DynamicFormRenderer'
+
+const validRoles = new Set([
+  'org:candidate',
+  'org:caregiver',
+  'org:admin',
+  'org:hr',
+])
+
+export default function FormSubmissionPage() {
+  const { formDefinitionId } = useParams<{ formDefinitionId: string }>()
+  const navigate = useNavigate()
+  const { orgRole, isLoaded } = useAuth()
+  const [isSubmitting, setIsSubmitting] = useState(false)
+
+  const formDefinitions = useQuery(
+    api.forms.listFormDefinitions,
+    formDefinitionId ? { id: formDefinitionId as Id<'forms'> } : 'skip',
+  )
+
+  const submit = useMutation(api.forms.submitForm)
+
+  if (!isLoaded) {
+    return <div className="p-8">Loading...</div>
+  }
+
+  if (!formDefinitionId) {
+    return <div className="p-8">Invalid form link.</div>
+  }
+
+  if (!validRoles.has(orgRole ?? '')) {
+    return <div className="p-8">You do not have permission to view this form.</div>
+  }
+
+  const formDefinition = (formDefinitions as Array<FormDefinition & { _id: string }> | undefined)?.find(
+    (f) => f._id === formDefinitionId,
+  )
+
+  const definitionForRenderer = formDefinition
+    ? {
+        id: formDefinition._id,
+        name: formDefinition.name,
+        fields: formDefinition.fields,
+      }
+    : null
+
+  const handleSubmit = async (data: Record<string, unknown>) => {
+    setIsSubmitting(true)
+    try {
+      await submit({ formDefinitionId: formDefinitionId as Id<'forms'>, data })
+      toast.success('Form submitted')
+      if (orgRole === 'org:candidate') {
+        navigate('/onboarding')
+      } else {
+        navigate(-1)
+      }
+    } finally {
+      setIsSubmitting(false)
+    }
+  }
+
+  return (
+    <div className="mx-auto max-w-2xl p-6">
+      {definitionForRenderer ? (
+        <DynamicFormRenderer
+          formDefinition={definitionForRenderer}
+          onSubmit={handleSubmit}
+          loading={isSubmitting}
+        />
+      ) : (
+        <div className="p-8 text-center">
+          {formDefinitions === undefined ? 'Loading form...' : 'Form not found.'}
+        </div>
+      )}
+    </div>
+  )
+}
