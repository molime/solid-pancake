+import { render, screen, fireEvent, waitFor } from '@testing-library/react'
+import { describe, it, expect, vi, beforeEach } from 'vitest'
+import { useParams, useNavigate } from 'react-router'
+import { useAuth } from '@clerk/clerk-react'
+import { useQuery, useMutation } from 'convex/react'
+import FormSubmissionPage from './FormSubmissionPage'
+
+vi.mock('react-router', async () => {
+  const actual = await vi.importActual('react-router')
+  return { ...actual, useParams: vi.fn(), useNavigate: vi.fn() }
+})
+
+vi.mock('@clerk/clerk-react', () => ({
+  useAuth: vi.fn(),
+}))
+
+vi.mock('convex/react', () => ({
+  useQuery: vi.fn(),
+  useMutation: vi.fn(),
+}))
+
+vi.mock('sonner', () => ({
+  toast: { success: vi.fn() },
+}))
+
+const mockedUseParams = vi.mocked(useParams)
+const mockedUseNavigate = vi.mocked(useNavigate)
+const mockedUseAuth = vi.mocked(useAuth)
+const mockedUseQuery = vi.mocked(useQuery)
+const mockedUseMutation = vi.mocked(useMutation)
+
+describe('FormSubmissionPage', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    mockedUseParams.mockReturnValue({ formDefinitionId: 'fd1' })
+    mockedUseAuth.mockReturnValue({ orgRole: 'org:candidate', isLoaded: true } as any)
+    mockedUseQuery.mockReturnValue([
+      {
+        _id: 'fd1',
+        name: 'Intake',
+        fields: [{ id: 'name', label: 'Name', type: 'text', required: true }],
+      },
+    ] as any)
+  })
+
+  it('fetches form definition and renders form', () => {
+    mockedUseMutation.mockReturnValue(vi.fn())
+    render(<FormSubmissionPage />)
+    expect(screen.getByText('Intake')).toBeInTheDocument()
+    expect(screen.getByLabelText(/Name/)).toBeInTheDocument()
+  })
+
+  it('calls submitForm and navigates to onboarding for candidates', async () => {
+    const submit = vi.fn().mockResolvedValue(undefined)
+    const navigate = vi.fn()
+    mockedUseMutation.mockReturnValue(submit)
+    mockedUseNavigate.mockReturnValue(navigate)
+    render(<FormSubmissionPage />)
+    fireEvent.change(screen.getByLabelText(/Name/), { target: { value: 'Ada' } })
+    fireEvent.click(screen.getByRole('button', { name: /Submit/ }))
+    await waitFor(() =>
+      expect(submit).toHaveBeenCalledWith({
+        formDefinitionId: 'fd1',
+        data: { name: 'Ada' },
+      }),
+    )
+    expect(navigate).toHaveBeenCalledWith('/onboarding')
+  })
+})